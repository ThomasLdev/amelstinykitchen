---
import { Font } from "astro:assets";
import "@styles/app.css";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import Seo from "@components/Seo.astro";
import SkipLink from "@components/SkipLink.astro";
import { useTranslations } from "@i18n";

type Props = Parameters<typeof Seo>[0];

const { locale, alternates } = Astro.props;
const t = useTranslations(locale);
---

<!doctype html>
<html lang={locale} data-palette="sage" data-density="aerated">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" href="/favicon.ico">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <meta name="generator" content={Astro.generator}>
    <Seo {...Astro.props} />
    <!-- Ordre des cascade layers déclaré avant tout style de composant (voir design-system) -->
    <style is:global is:inline>
    @layer tokens, base, components;
    </style>
    <Font cssVariable="--font-tinos" preload={[{ weight: 400, style: "normal" }]} />
    <Font cssVariable="--font-ubuntu" preload={[{ weight: 400, style: "normal" }]} />
    <Font cssVariable="--font-ubuntu-mono" />
  </head>
  <body>
    <SkipLink>{t.a11y.skipToContent}</SkipLink>
    <Header locale={locale} alternates={alternates} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
