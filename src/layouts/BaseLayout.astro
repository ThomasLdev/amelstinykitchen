---
import { Font } from "astro:assets";
import "@styles/app.css";
import Container from "@components/Container.astro";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import Seo from "@components/Seo.astro";
import SkipLink from "@components/SkipLink.astro";
import { useTranslations } from "@i18n";

type Props = Parameters<typeof Seo>[0];

const { locale, alternates } = Astro.props;
const t = useTranslations(locale);
---

<!doctype html>
<html lang={locale} data-palette="sage" data-density="aerated">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!-- `sizes` keeps browsers that read SVG from picking the ICO. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.webmanifest">
    <meta name="generator" content={Astro.generator}>
    <Seo {...Astro.props} />
    <!-- Layer order declared before any component style (see the design-system skill). -->
    <style is:global is:inline>
    @layer tokens, base, components;
    </style>
    <!-- Every variant painted above the fold: with `display: optional` a late one would never show. -->
    <Font cssVariable="--font-tinos" preload />
    <Font cssVariable="--font-ubuntu" preload />
    <Font cssVariable="--font-ubuntu-mono" preload />
    <slot name="head" />
  </head>
  <body>
    <SkipLink>{t.a11y.skipToContent}</SkipLink>
    <Header locale={locale} />
    <main id="main" class="main">
      {Astro.slots.has("breadcrumb") && (
        <Container class="main__breadcrumb">
          <slot name="breadcrumb" />
        </Container>
      )}
      <slot />
    </main>
    <Footer locale={locale} alternates={alternates} />
  </body>
</html>

<style>
@layer components {
  .main {
    padding-block: var(--page-space-start) var(--page-space-end);

    @media print {
      padding-block: 0;
    }
  }

  /* A single spot shared by every page, so the breadcrumb stays still across navigations. */
  .main__breadcrumb {
    margin-block-end: var(--space-3);
    view-transition-name: breadcrumb;

    @media print {
      display: none;
    }
  }
}
</style>
