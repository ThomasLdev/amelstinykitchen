---
import { getRelativeLocaleUrl } from "astro:i18n";
import Container from "@components/Container.astro";
import Icon from "@components/Icon.astro";
import Logo from "@components/Logo.astro";
import { type Locale, languages, useTranslations } from "@i18n";
import { siteConfig } from "@site";

interface Props {
  locale: Locale;
  /** Locale-relative path of the current page per locale, for the language switch. */
  alternates?: Partial<Record<Locale, string>>;
  class?: string;
  [key: string]: unknown;
}

const { locale, alternates = {}, class: className, ...rest } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();
const homeHref = getRelativeLocaleUrl(locale, "");
const recipesHref = getRelativeLocaleUrl(locale, "recipes");
const socials = [
  { label: t.footer.instagram, href: siteConfig.social.instagram },
  { label: t.footer.pinterest, href: siteConfig.social.pinterest },
].filter((social) => social.href !== "");

const switchLocale = (Object.keys(languages) as Locale[]).find((lang) => lang !== locale);
const switchPath = switchLocale && alternates[switchLocale];
const languageSwitch =
  switchLocale && switchPath !== undefined
    ? {
        lang: switchLocale,
        href: getRelativeLocaleUrl(switchLocale, switchPath),
        label: useTranslations(switchLocale).footer.languageName,
      }
    : undefined;
---

<footer class:list={["footer", className]} data-site-footer {...rest}>
  <Container>
    <div class="footer__top">
      <div class="footer__grid">
        <div class="footer__brand">
          <div class="footer__logo">
            <Logo locale={locale} variant="footer" />
          </div>
          <p class="footer__tagline">{t.footer.tagline}</p>
        </div>

        <details class="footer__col" open>
          <summary class="footer__head">
            <span>{t.footer.recipesTitle}</span>
            <span class="footer__chev" aria-hidden="true">
              <Icon name="plus" size={18} />
            </span>
          </summary>
          <div class="footer__body">
            <ul class="footer__links" aria-label={t.footer.recipesAriaLabel}>
              {t.footer.recipesLinks.map((label) => (
                <li>
                  <a href={recipesHref} class="footer__link">
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </details>
      </div>
    </div>

    <div class="footer__bottom">
      <span class="footer__copy">
        &copy; {year}
        <a class="footer__home" href={homeHref}>{t.brand.name} {t.brand.nameAccent}</a>
        {" · "}
        {t.footer.copyright}
      </span>
      <div class="footer__aside">
        {socials.length > 0 && (
          <ul class="footer__socials" aria-label={t.footer.socialsAriaLabel}>
            {socials.map((social) => (
              <li class="footer__socials-item">
                <a href={social.href} class="footer__social" rel="me">
                  {social.label}
                </a>
              </li>
            ))}
          </ul>
        )}
        {languageSwitch && (
          <a
            href={languageSwitch.href}
            class="footer__lang"
            hreflang={languageSwitch.lang}
            lang={languageSwitch.lang}
          >
            <Icon name="languages" size={16} />
            {languageSwitch.label}
          </a>
        )}
      </div>
    </div>
  </Container>
</footer>

<style>
@layer components {
  .footer {
    margin-block-start: var(--space-6);
    padding-block: var(--space-5) var(--space-3);
    background: var(--ink);
    color: var(--on-ink-soft);
  }

  .footer__top {
    padding-block-end: var(--space-4);
  }

  .footer__grid {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .footer__brand {
    padding-block-end: var(--space-4);
    border-block-end: 1px solid var(--on-ink-line);
    margin-block-end: var(--space-2);
  }

  .footer__logo {
    margin-block-end: 0.875rem;
  }

  .footer__tagline {
    max-width: 36ch;
    color: var(--on-ink-muted);
    font-size: 0.875rem;
  }

  .footer__col {
    border-block-end: 1px solid var(--on-ink-line);
    interpolate-size: allow-keywords;
  }

  .footer__col::details-content {
    block-size: 0;
    overflow: clip;
    opacity: 0;
    transition:
      content-visibility var(--transition-drawer) allow-discrete,
      block-size var(--transition-drawer),
      opacity var(--transition-drawer);
  }

  .footer__col[open]::details-content {
    block-size: auto;
    opacity: 1;
  }

  .footer__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding-block: 1.125rem;
    list-style: none;
    cursor: pointer;
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    color: var(--on-ink);
  }

  .footer__head::-webkit-details-marker {
    display: none;
  }

  .footer__chev {
    display: inline-flex;
    color: var(--accent-soft);
    transition: transform var(--transition-base);
  }

  .footer__col[open] .footer__chev {
    transform: rotate(45deg);
  }

  .footer__body {
    padding-block-end: 1.125rem;
  }

  .footer__links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer__link,
  .footer__home,
  .footer__social,
  .footer__lang {
    transition: color var(--transition-base);
  }

  .footer__link {
    color: var(--on-ink-muted);
    font-size: 0.875rem;
  }

  .footer__link:hover,
  .footer__link:focus-visible {
    color: var(--accent-soft);
  }

  .footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin-block-start: var(--space-3);
    padding-block-start: var(--space-3);
    border-block-start: 1px solid var(--on-ink-line);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    color: var(--on-ink-dim);
  }

  .footer__home {
    color: var(--on-ink-muted);
  }

  .footer__home:hover,
  .footer__home:focus-visible {
    color: var(--accent-soft);
  }

  .footer__aside {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem 1.25rem;
  }

  .footer__lang {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    font-size: 0.6875rem;
  }

  .footer__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
  }

  .footer__socials-item {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .footer__socials-item:not(:last-child)::after {
    content: "·";
    color: var(--on-ink-dim);
  }

  .footer__social {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }

  .footer__social,
  .footer__lang {
    color: var(--on-ink-muted);
  }

  .footer__social:hover,
  .footer__social:focus-visible,
  .footer__lang:hover,
  .footer__lang:focus-visible {
    color: var(--accent-soft);
  }

  @media (min-width: 720px) {
    .footer {
      padding-block: var(--space-6) var(--space-3);
    }

    .footer__grid {
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      gap: var(--space-4);
    }

    .footer__brand {
      grid-column: 1;
      border: 0;
      padding: 0;
      margin: 0;
    }

    .footer__col {
      border: 0;
    }

    .footer__col::details-content,
    .footer__col[open]::details-content {
      block-size: auto;
      opacity: 1;
    }

    .footer__head {
      padding-block: 0 1.125rem;
      pointer-events: none;
      cursor: default;
    }

    .footer__chev {
      display: none;
    }

    .footer__body {
      display: block;
      padding-block-end: 0;
    }

    .footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .footer {
    @media print {
      display: none;
    }
  }
}
</style>
