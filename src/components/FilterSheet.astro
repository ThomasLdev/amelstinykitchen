---
import Icon from "@components/Icon.astro";

interface Props {
  title: string;
  closeLabel: string;
  resetLabel: string;
  applyLabel: string;
  id?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  title,
  closeLabel,
  resetLabel,
  applyLabel,
  id = "filters",
  class: className,
  ...rest
} = Astro.props;
const titleId = `${id}-title`;
// Phones: modal sheet opened from a button. From 900px src/scripts/recipes
// keeps it open, non-modal, as the sidebar.
---

<dialog
  class:list={["filter-sheet", className]}
  id={id}
  aria-labelledby={titleId}
  data-filters
  {...rest}
>
  <div class="filter-sheet__panel">
    <span class="filter-sheet__grip" aria-hidden="true"></span>
    <div class="filter-sheet__head">
      <button type="button" class="filter-sheet__reset" data-filters-reset>{resetLabel}</button>
      <h2 class="filter-sheet__title" id={titleId}>{title}</h2>
      <button type="button" class="filter-sheet__close" aria-label={closeLabel} data-filters-close>
        <Icon name="x" size={16} />
      </button>
    </div>
    <div class="filter-sheet__body">
      <slot />
    </div>
    <div class="filter-sheet__foot">
      <button type="button" class="filter-sheet__apply" data-filters-apply>{applyLabel}</button>
    </div>
  </div>
</dialog>

<style>
@layer components {
  .filter-sheet {
    inset: auto 0 0;
    inline-size: 100%;
    max-inline-size: none;
    max-block-size: min(88dvh, 46rem);
    margin: 0;
    padding: 0;
    border: 0;
    border-start-start-radius: var(--radius-lg);
    border-start-end-radius: var(--radius-lg);
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow-sheet);
    overflow: hidden;
    translate: 0 100%;
    transition:
      translate var(--transition-drawer),
      display var(--transition-drawer) allow-discrete,
      overlay var(--transition-drawer) allow-discrete;

    &[open] {
      display: flex;
      translate: 0 0;

      @starting-style {
        translate: 0 100%;
      }
    }

    &::backdrop {
      background: var(--overlay);
    }
  }

  .filter-sheet__panel {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-block-size: 0;
  }

  .filter-sheet__grip {
    align-self: center;
    inline-size: 2.25rem;
    block-size: 5px;
    margin-block: 0.5rem 0.125rem;
    border-radius: var(--radius-pill);
    background: var(--line);
  }

  .filter-sheet__head {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-block-size: 3.25rem;
    padding-inline: 0.5rem;
    border-block-end: 1px solid var(--line);
  }

  .filter-sheet__reset {
    justify-self: start;
    min-block-size: 2.75rem;
    padding-inline: 0.625rem;
    font-size: 0.9375rem;
    color: var(--accent-ink);
  }

  .filter-sheet__title {
    font-size: 1.0625rem;
    font-weight: 500;
  }

  .filter-sheet__close {
    display: grid;
    place-items: center;
    justify-self: end;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border-radius: 50%;
    color: var(--ink);

    &:hover {
      background: var(--bg-deep);
    }
  }

  .filter-sheet__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1.75rem;
    padding: 1.25rem var(--gutter);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .filter-sheet__foot {
    padding: 0.75rem var(--gutter) max(1rem, env(safe-area-inset-bottom));
    border-block-start: 1px solid var(--line);
  }

  .filter-sheet__apply {
    inline-size: 100%;
    min-block-size: 3.25rem;
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--on-ink);
    font-size: 1rem;
    font-weight: 500;
    transition: background var(--transition-base);

    &:hover {
      background: var(--accent-ink);
    }
  }

  @media (min-width: 900px) {
    .filter-sheet[open]:not(:modal) {
      position: static;
      display: block;
      max-block-size: none;
      border-radius: 0;
      background: none;
      box-shadow: none;
      overflow: visible;
      translate: none;
      transition: none;
    }

    .filter-sheet__grip,
    .filter-sheet__head,
    .filter-sheet__foot {
      display: none;
    }

    .filter-sheet__body {
      gap: 2rem;
      padding: 0;
      overflow: visible;
    }
  }

  /* showModal() makes the page inert but still lets it scroll behind the sheet. */
  :global(html:has(dialog.filter-sheet:modal)) {
    overflow: hidden;
  }
}
</style>
