---
interface Props {
  title: string;
  titleEm?: string;
  class?: string;
  [key: string]: unknown;
}

const { title, titleEm, class: className, ...rest } = Astro.props;
---

<header class:list={["page-header", className]} {...rest}>
  <h1 class="page-header__title">
    {title} {titleEm && <em class="page-header__title-em">{titleEm}</em>}
  </h1>
</header>

<style>
@layer components {
  .page-header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-block-end: var(--space-3);

    @media (min-width: 900px) {
      padding-block-end: var(--space-4);
    }
  }

  .page-header__title {
    font-family: var(--font-serif);
    font-size: clamp(2.125rem, 5vw, 3.25rem);
    font-weight: 400;
    line-height: 1.05;
    color: var(--ink);
    text-wrap: balance;
  }

  .page-header__title-em {
    color: var(--accent-ink);
  }
}
</style>
