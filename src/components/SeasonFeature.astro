---
import { Picture } from "astro:assets";
import Button from "@components/Button.astro";
import type { Season } from "@lib/content/season";
import type { ImageMetadata } from "astro";

interface Recipe {
  href: string;
  title: string;
  meta?: string;
  image?: ImageMetadata;
}

interface Props {
  season: Season;
  /** Before, emphasized, after. */
  title: [string, string, string];
  badge: string;
  image: ImageMetadata;
  recipes: Recipe[];
  cta: { href: string; label: string };
  hidden?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  season,
  title: [before, em, after],
  badge,
  image,
  recipes,
  cta,
  hidden = false,
  class: className,
  ...rest
} = Astro.props;
---

<article class:list={["season", className]} data-season-card={season} hidden={hidden} {...rest}>
  <Picture
    src={image}
    alt=""
    formats={["avif", "webp"]}
    widths={[480, 720, 960, 1200]}
    sizes="(min-width: 1200px) 36rem, (min-width: 720px) 50vw, 100vw"
    class="season__image"
  />
  <div class="season__body">
    <span class="season__badge">{badge}</span>
    <h3 class="season__title">{before}<em class="season__title-em">{em}</em>{after}</h3>
    <ul class="season__recipes">
      {recipes.map((recipe) => (
        <li class="season__recipe">
          <a class="season__link" href={recipe.href}>
            {recipe.image && (
              <Picture
                src={recipe.image}
                alt=""
                formats={["avif", "webp"]}
                widths={[56, 112]}
                sizes="3.25rem"
                class="season__thumb"
              />
            )}
            <span class="season__name">{recipe.title}</span>
            {recipe.meta && <span class="season__meta">{recipe.meta}</span>}
          </a>
        </li>
      ))}
    </ul>
    <Button href={cta.href} variant="ink" class="season__cta">{cta.label}</Button>
  </div>
</article>

<style>
@layer components {
  .season {
    position: relative;
    display: grid;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--surface);

    /* Every season is rendered; the script keeps the visitor's one. */
    &[hidden] {
      display: none;
    }

    @media (min-width: 720px) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .season__image {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;

    @media (min-width: 720px) {
      block-size: 100%;
      min-block-size: 21rem;
      /* The photos' own ratio, known before they load: `auto` let the row grow on load. */
      aspect-ratio: 3 / 2;
    }
  }

  .season__body {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 1rem 1.125rem 1.125rem;

    @media (min-width: 720px) {
      gap: 0.875rem;
      padding: 2rem 2.25rem;
    }
  }

  /* On phones the badge sits on the photo, which comes first. */
  .season__badge {
    position: absolute;
    inset-block-start: 0.75rem;
    inset-inline-start: 0.75rem;
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-pill);
    background: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--on-ink);

    @media (min-width: 720px) {
      position: static;
      align-self: flex-start;
    }
  }

  .season__title {
    font-family: var(--font-serif);
    font-size: 1.625rem;
    font-weight: 400;
    line-height: 1.1;

    @media (min-width: 720px) {
      font-size: clamp(1.875rem, 3vw, 2.375rem);
    }
  }

  .season__title-em {
    color: var(--accent-ink);
  }

  .season__recipes {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .season__recipe {
    border-block-start: 1px solid var(--line);

    &:last-child {
      border-block-end: 1px solid var(--line);
    }

    /* Phones keep two recipes: the list must not push the button away. */
    &:nth-child(n + 3) {
      display: none;

      @media (min-width: 720px) {
        display: block;
      }
    }
  }

  .season__link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-block-size: 2.75rem;
    padding-block: 0.5rem;

    @media (min-width: 720px) {
      gap: 0.875rem;
      padding-block: 0.625rem;
    }
  }

  .season__thumb {
    flex: none;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border-radius: var(--radius-sm);
    object-fit: cover;

    @media (min-width: 720px) {
      inline-size: 3.25rem;
      block-size: 3.25rem;
    }
  }

  .season__name {
    flex: 1;
    font-family: var(--font-serif);
    font-size: 1rem;
    transition: color var(--transition-base);

    .season__link:hover & {
      color: var(--accent-ink);
    }

    @media (min-width: 720px) {
      font-size: 1.125rem;
    }
  }

  .season__meta {
    display: none;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-3);

    @media (min-width: 720px) {
      display: inline;
    }
  }

  .season__cta {
    margin-block-start: 0.25rem;

    @media (min-width: 720px) {
      align-self: flex-start;
    }
  }
}
</style>
