---
import { type Locale, useTranslations } from "@i18n";

interface Props {
  title?: string;
  body?: string;
  locale: Locale;
  class?: string;
  [key: string]: unknown;
}

const { title, body, locale, class: className, ...rest } = Astro.props;
const t = useTranslations(locale);
---

{(title || body) && (
  <aside class:list={["chef-note", className]} {...rest}>
    <div class="chef-note__head">
      <span class="chef-note__label">{t.recipe.chef.label}</span>
    </div>
    <div class="chef-note__body">
      {title && (
        <h3 class="chef-note__title">
          <Fragment set:html={title} />
        </h3>
      )}
      {body && <p class="chef-note__text">{body}</p>}
    </div>
  </aside>
)}

<style>
@layer components {
  .chef-note {
    margin-block-start: var(--space-4);
    background: var(--ink);
    color: var(--on-ink-soft);
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    gap: 1rem;

    .chef-note__head {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .chef-note__label {
      font-family: var(--font-mono);
      font-size: 0.625rem;
      text-transform: uppercase;
      color: var(--accent-soft);
    }

    .chef-note__title {
      color: var(--on-ink);
      font-size: clamp(1.375rem, 5vw, 1.75rem);
      margin: 0;

      :global(em) {
        color: var(--accent-soft);
        font-style: italic;
        font-weight: 300;
      }
    }

    .chef-note__text {
      color: var(--on-ink-muted);
      font-size: 0.875rem;
      margin-block: 0.5rem 0;
    }

    @media (min-width: 720px) {
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: 2rem;
      align-items: center;
      padding: var(--space-5);

      .chef-note__head {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.625rem;
      }

      .chef-note__text {
        font-size: 0.9375rem;
      }
    }
  }

  /* Print: dark card backgrounds are not printed, so switch to ink on paper. */
  .chef-note {
    @media print {
      background: none;
      color: var(--ink);
      border: 1px solid var(--line);
      break-inside: avoid;

      .chef-note__label {
        color: var(--accent-ink);
      }

      .chef-note__title {
        color: var(--ink);

        :global(em) {
          color: var(--accent-ink);
        }
      }

      .chef-note__text {
        color: var(--ink-2);
      }
    }
  }
}
</style>
