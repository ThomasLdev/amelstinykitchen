---
import { getRelativeLocaleUrl } from "astro:i18n";
import Icon from "@components/Icon.astro";
import Logo from "@components/Logo.astro";
import { type Locale, languages, useTranslations } from "@i18n";

interface Props {
  locale: Locale;
  /** Locale-relative path of the current page per locale, for the language switch. */
  alternates?: Partial<Record<Locale, string>>;
  class?: string;
  [key: string]: unknown;
}

const { locale, alternates = {}, class: className, ...rest } = Astro.props;
const t = useTranslations(locale);

const switchLocale = (Object.keys(languages) as Locale[]).find((lang) => lang !== locale);
const switchPath = switchLocale && alternates[switchLocale];
const languageSwitch =
  switchLocale && switchPath !== undefined
    ? {
        lang: switchLocale,
        href: getRelativeLocaleUrl(switchLocale, switchPath),
        label: useTranslations(switchLocale).header.languageName,
      }
    : undefined;

const items = [
  { label: t.header.home, icon: "house", href: getRelativeLocaleUrl(locale, "") },
  { label: t.header.recipes, icon: "cookie", href: getRelativeLocaleUrl(locale, "recipes") },
];

const currentPath = Astro.url.pathname;
const normalize = (path: string) => (path.endsWith("/") ? path : `${path}/`);
const isCurrent = (href: string) => normalize(currentPath) === normalize(href);
---

<header class:list={["nav-wrapper", className]} data-nav {...rest}>
  <nav class="nav" aria-label={t.header.navAriaLabel}>
    <div class="nav__inner">
      <div class="nav__brand">
        <Logo locale={locale} />
      </div>

      <ul class="nav__items">
        {items.map((item) => (
          <li>
            <a
              href={item.href}
              class="nav__item"
              aria-current={isCurrent(item.href) ? "page" : undefined}
            >
              <Icon name={item.icon} size={18} />
              <span class="nav__item-label">{item.label}</span>
            </a>
          </li>
        ))}
        <li>
          <button type="button" class="nav__item">
            <Icon name="search" size={18} />
            <span class="nav__item-label">{t.header.search}</span>
          </button>
        </li>
        {languageSwitch && (
          <li>
            <a
              href={languageSwitch.href}
              class="nav__item"
              hreflang={languageSwitch.lang}
              lang={languageSwitch.lang}
            >
              <Icon name="languages" size={18} />
              <span class="nav__item-label">{languageSwitch.label}</span>
            </a>
          </li>
        )}
      </ul>
    </div>
  </nav>
</header>

<script>
import "@scripts/nav";
</script>

<style>
@layer components {
  .nav-wrapper {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 2;
    display: flex;
    justify-content: center;
    padding-inline: var(--gutter);
    padding-block-end: var(--space-2);
    transition: translate var(--transition-drawer);

    /* Mobile only (the desktop nav is static at the top): slid out of view
       while scrolling down or over the footer (state set by
       src/scripts/nav.ts), but brought back on keyboard focus. */
    @media (width < 1200px) {
      &[data-nav-state="hidden"]:not(:focus-within) {
        translate: 0 100%;
      }
    }

    @media (min-width: 1200px) {
      position: static;
      display: block;
      padding: 0;
    }
  }

  .nav {
    max-width: 100%;
    background: var(--surface-translucent);
    backdrop-filter: saturate(1.2) blur(10px);
    -webkit-backdrop-filter: saturate(1.2) blur(10px);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-card);

    @media (min-width: 1200px) {
      max-width: none;
      background: color-mix(in oklab, var(--bg), transparent 6%);
      border: 0;
      border-block-end: 1px solid var(--line);
      border-radius: 0;
      box-shadow: none;
    }
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: var(--nav-h);
    max-width: var(--max-width-xl);
    margin-inline: auto;
    padding-block: 0.375rem;
    padding-inline: var(--space-2);

    @media (min-width: 900px) {
      min-height: 4.75rem;
    }

    @media (min-width: 1200px) {
      justify-content: space-between;
      padding-block: 0;
      padding-inline: var(--gutter);
    }
  }

  .nav__brand {
    display: none;

    @media (min-width: 1200px) {
      display: flex;
    }
  }

  .nav__items {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;

    @media (min-width: 1200px) {
      flex-wrap: nowrap;
    }
  }

  .nav__item {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    padding-inline: 0.625rem;
    border-radius: var(--radius-pill);
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    transition:
      color var(--transition-base),
      background var(--transition-base);

    &:hover,
    &[aria-current="page"] {
      color: var(--accent-ink);
      background: var(--accent-bg);
    }
  }

  .nav-wrapper {
    @media print {
      display: none;
    }
  }
}
</style>
