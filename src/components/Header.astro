---
import { getRelativeLocaleUrl } from "astro:i18n";
import Icon from "@components/Icon.astro";
import Logo from "@components/Logo.astro";
import { type Locale, useTranslations } from "@i18n";

interface Props {
  locale: Locale;
  class?: string;
  [key: string]: unknown;
}

const { locale, class: className, ...rest } = Astro.props;
const t = useTranslations(locale);

const items = [
  { label: t.header.home, icon: "house", href: getRelativeLocaleUrl(locale, "") },
  { label: t.header.recipes, icon: "cookie", href: getRelativeLocaleUrl(locale, "recipes") },
];

const currentPath = Astro.url.pathname;
const normalize = (path: string) => (path.endsWith("/") ? path : `${path}/`);
const isCurrent = (href: string) => normalize(currentPath) === normalize(href);
---

<header class:list={["nav-wrapper", className]} {...rest}>
  <nav class="nav" aria-label={t.header.navAriaLabel}>
    <div class="nav__inner">
      <Logo locale={locale} />

      <ul class="nav__items">
        {items.map((item) => (
          <li>
            <a
              href={item.href}
              class="nav__item"
              aria-current={isCurrent(item.href) ? "page" : undefined}
            >
              <Icon name={item.icon} size={18} />
              <span class="nav__item-label">{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
</header>

<style>
@layer components {
  .nav-wrapper {
    position: fixed;
    bottom: 0;
    width: 100%;
    z-index: 2;
    border-block-start: 1px solid var(--ink);

    @media (min-width: 1200px) {
      position: static;
      bottom: unset;
      border-block-start: 0;
    }
  }

  .nav {
    background: color-mix(in oklab, var(--bg), transparent 6%);
    backdrop-filter: saturate(1.2) blur(10px);
    -webkit-backdrop-filter: saturate(1.2) blur(10px);
    border-block-end: 1px solid var(--line);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    height: var(--nav-h);
    max-width: var(--max-width-xl);
    margin-inline: auto;
    padding-inline: var(--gutter);

    @media (min-width: 900px) {
      height: 4.75rem;
    }
  }

  .nav__items {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;

    @media (min-width: 1200px) {
      justify-content: end;
    }
  }

  .nav__item {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    padding-inline: 0.625rem;
    border-radius: var(--radius-pill);
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    transition:
      color var(--transition-base),
      background var(--transition-base);

    &:hover,
    &[aria-current="page"] {
      color: var(--accent-ink);
      background: var(--accent-bg);
    }
  }
}
</style>
