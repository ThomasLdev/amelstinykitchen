---
const icons = import.meta.glob("../icons/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
}) as Record<string, string>;

interface Props {
  name: string;
  size?: number;
  class?: string;
  [key: string]: unknown;
}

const { name, size = 24, class: className, ...rest } = Astro.props;
const raw = icons[`../icons/${name}.svg`] ?? "";
const inner = raw
  .replace(/^[\s\S]*?<svg[^>]*>/, "")
  .replace(/<\/svg>\s*$/, "")
  .trim();
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class:list={["icon", className]}
  set:html={inner}
  {...rest}
/>

<style>
@layer components {
  .icon {
    display: inline-block;
    flex-shrink: 0;
    vertical-align: middle;
  }
}
</style>
