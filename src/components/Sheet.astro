---
import Icon from "@components/Icon.astro";

interface Props {
  title: string;
  closeLabel: string;
  /**
   * Wide screens: `sidebar` keeps the content in the page, open and not modal
   * from 900px; `dialog` centers it as a panel.
   */
  desktop?: "sidebar" | "dialog";
  id: string;
  class?: string;
  [key: string]: unknown;
}

const { title, closeLabel, desktop = "dialog", id, class: className, ...rest } = Astro.props;
const titleId = `${id}-title`;
// Same breakpoint as the `.sheet--sidebar` rules below.
const sidebarMedia = "(width >= 900px)";
// Where the sheet is a bottom sheet, and so can be dragged down to close.
const dragMedia = desktop === "sidebar" ? "(width < 900px)" : "(width < 720px)";
---

<dialog
  class:list={["sheet", `sheet--${desktop}`, className]}
  id={id}
  aria-labelledby={titleId}
  data-sheet
  data-sheet-drag={dragMedia}
  data-sheet-sidebar={desktop === "sidebar" ? sidebarMedia : undefined}
  {...rest}
>
  <div class="sheet__panel">
    <span class="sheet__grip" aria-hidden="true" data-sheet-handle></span>
    <div class="sheet__head" data-sheet-handle>
      <div class="sheet__start">
        <slot name="start" />
      </div>
      <h2 class="sheet__title" id={titleId}>{title}</h2>
      <button type="button" class="sheet__close" aria-label={closeLabel} data-sheet-close>
        <Icon name="x" size={16} />
      </button>
    </div>
    <div class="sheet__body">
      <slot />
    </div>
    {Astro.slots.has("foot") && (
      <div class="sheet__foot">
        <slot name="foot" />
      </div>
    )}
  </div>
</dialog>

<script>
import "@scripts/sheet";
</script>

<style>
@layer components {
  /* Phones, every sheet: rises from the bottom over a dimmed page. */
  .sheet {
    inset: auto 0 0;
    inline-size: 100%;
    max-inline-size: none;
    max-block-size: min(88dvh, 46rem);
    margin: 0;
    padding: 0;
    border: 0;
    border-start-start-radius: var(--radius-lg);
    border-start-end-radius: var(--radius-lg);
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow-sheet);
    overflow: hidden;
    translate: 0 100%;
    transition:
      translate var(--transition-drawer),
      display var(--transition-drawer) allow-discrete,
      overlay var(--transition-drawer) allow-discrete;

    &[open] {
      display: flex;
      translate: 0 0;

      @starting-style {
        translate: 0 100%;
      }
    }

    &::backdrop {
      background: var(--overlay);
    }
  }

  .sheet__panel {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-inline-size: 0;
    min-block-size: 0;
  }

  /* Dragged down to close on phones: the browser must not scroll or zoom on it. */
  .sheet__grip,
  .sheet__head {
    touch-action: none;
  }

  .sheet__grip {
    align-self: center;
    inline-size: 2.25rem;
    block-size: 5px;
    margin-block: 0.5rem 0.125rem;
    border-radius: var(--radius-pill);
    background: var(--line);
  }

  .sheet__head {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-block-size: 3.25rem;
    padding-inline: 0.5rem;
    border-block-end: 1px solid var(--line);
  }

  .sheet__start {
    justify-self: start;
  }

  .sheet__title {
    font-size: 1.0625rem;
    font-weight: 500;
  }

  .sheet__close {
    display: grid;
    place-items: center;
    justify-self: end;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border-radius: 50%;
    color: var(--ink);

    &:hover {
      background: var(--bg-deep);
    }
  }

  .sheet__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1.75rem;
    padding: 1.25rem var(--gutter) max(1.25rem, env(safe-area-inset-bottom));
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .sheet__foot {
    padding: 0.75rem var(--gutter) max(1rem, env(safe-area-inset-bottom));
    border-block-start: 1px solid var(--line);
  }

  @media (min-width: 900px) {
    .sheet--sidebar[open]:not(:modal) {
      position: static;
      display: block;
      max-block-size: none;
      border-radius: 0;
      background: none;
      box-shadow: none;
      overflow: visible;
      translate: none;
      transition: none;

      .sheet__grip,
      .sheet__head,
      .sheet__foot {
        display: none;
      }

      .sheet__body {
        gap: 2rem;
        padding: 0;
        overflow: visible;
      }
    }
  }

  @media (min-width: 720px) {
    .sheet--dialog {
      inset: 10dvh 0 auto;
      inline-size: min(40rem, 100% - 2 * var(--gutter));
      block-size: auto;
      max-block-size: 75dvh;
      margin-inline: auto;
      border-radius: var(--radius-lg);
      translate: 0 -0.75rem;
      opacity: 0;
      transition:
        translate var(--transition-base),
        opacity var(--transition-base),
        display var(--transition-base) allow-discrete,
        overlay var(--transition-base) allow-discrete;

      &[open] {
        translate: 0 0;
        opacity: 1;

        @starting-style {
          translate: 0 -0.75rem;
          opacity: 0;
        }
      }

      .sheet__grip {
        display: none;
      }
    }
  }

  /* showModal() makes the page inert but still lets it scroll behind the sheet. */
  :global(html:has(.sheet:modal)) {
    overflow: hidden;
  }
}
</style>
