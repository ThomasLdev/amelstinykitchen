---
import { Picture } from "astro:assets";
import Icon from "@components/Icon.astro";
import { type Locale, useTranslations } from "@i18n";
import type { ImageMetadata } from "astro";

interface Media {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  media: Media[];
  locale: Locale;
  variant?: "hero" | "default";
  widths?: number[];
  sizes?: string;
  eager?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  media,
  locale,
  variant = "default",
  widths = [480, 720, 960],
  sizes = "100vw",
  eager = false,
  class: className,
  ...rest
} = Astro.props;
const t = useTranslations(locale);
const variantClass = `media-carousel--${variant}`;

/** Rendered aspect ratio per variant: images are cropped to it at build time. */
const ratios = { hero: 4 / 3, default: 16 / 9 } as const;
const formats: ("avif" | "webp")[] = ["avif", "webp"];

/** Largest generated width, capped to the source so nothing is upscaled. */
const cropSize = (src: ImageMetadata) => {
  const width = Math.min(src.width, Math.max(...widths));
  return { width, height: Math.round(width / ratios[variant]) };
};
const single = media.length === 1 ? media[0] : undefined;
const multiple = media.length > 1;
---

{single && (
  <figure
    class:list={["media-carousel", "media-carousel--single", variantClass, className]}
    {...rest}
  >
    <Picture
      src={single.src}
      alt={single.alt}
      formats={formats}
      {...cropSize(single.src)}
      fit="cover"
      widths={widths}
      sizes={sizes}
      priority={eager}
      class="media-carousel__image"
      pictureAttributes={{ class: "media-carousel__picture" }}
    />
  </figure>
)}

{multiple && (
  <section
    class:list={["media-carousel", "media-carousel--multiple", variantClass, className]}
    aria-label={t.a11y.carousel}
    aria-roledescription={t.a11y.carouselRole}
    data-carousel
    {...rest}
  >
    <ul class="media-carousel__track" data-carousel-track tabindex="0">
      {media.map((item, index) => (
        <li
          class="media-carousel__slide"
          role="group"
          aria-roledescription={t.a11y.slide}
          aria-label={t.a11y.slidePosition(index + 1, media.length)}
        >
          <Picture
            src={item.src}
            alt={item.alt}
            formats={formats}
            {...cropSize(item.src)}
            fit="cover"
            widths={widths}
            sizes={sizes}
            priority={eager && index === 0}
            class="media-carousel__image"
            pictureAttributes={{ class: "media-carousel__picture" }}
          />
        </li>
      ))}
    </ul>

    <button
      type="button"
      class="media-carousel__nav media-carousel__nav--prev"
      data-carousel-prev
      aria-label={t.a11y.carouselPrevious}
    >
      <Icon name="chevron-left" size={20} />
    </button>
    <button
      type="button"
      class="media-carousel__nav media-carousel__nav--next"
      data-carousel-next
      aria-label={t.a11y.carouselNext}
    >
      <Icon name="chevron-right" size={20} />
    </button>

    <div class="media-carousel__dots">
      {media.map((_item, index) => (
        <button
          type="button"
          class="media-carousel__dot"
          data-carousel-dot
          data-index={index}
          aria-label={t.a11y.slidePosition(index + 1, media.length)}
          aria-current={index === 0 ? "true" : undefined}
        />
      ))}
    </div>
  </section>
)}

<style>
@layer components {
  .media-carousel__picture {
    display: block;
    height: 100%;
  }

  .media-carousel__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media-carousel--single {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--accent-soft);
    margin: 0;
  }

  .media-carousel--multiple {
    position: relative;

    .media-carousel__track {
      display: flex;
      gap: 0.75rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;

      &::-webkit-scrollbar {
        display: none;
      }
    }

    .media-carousel__slide {
      flex: 0 0 85%;
      scroll-snap-align: start;
      aspect-ratio: 16 / 9;
      border-radius: var(--radius-md);
      overflow: hidden;
      background: var(--accent-soft);
    }

    .media-carousel__nav {
      display: none;
      position: absolute;
      inset-block-start: 50%;
      transform: translateY(-50%);
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      border-radius: 50%;
      background: var(--surface-translucent);
      color: var(--ink);
      transition:
        background var(--transition-base),
        color var(--transition-base),
        opacity var(--transition-base);

      &:hover {
        background: var(--surface);
        color: var(--accent-ink);
      }

      &:focus-visible {
        border-radius: var(--radius-pill);
      }

      &:disabled {
        opacity: 0;
        pointer-events: none;
      }
    }

    .media-carousel__nav--prev {
      inset-inline-start: 0.75rem;
    }

    .media-carousel__nav--next {
      inset-inline-end: 0.75rem;
    }

    .media-carousel__dots {
      display: none;
      position: absolute;
      inset-block-end: 0.75rem;
      inset-inline: 0;
      justify-content: center;
      gap: 0.25rem;
    }

    .media-carousel__dot {
      display: grid;
      place-items: center;
      width: 1.5rem;
      height: 1.5rem;
      border-radius: 50%;

      &::before {
        content: "";
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 50%;
        background: color-mix(in oklab, var(--on-ink) 55%, transparent);
        box-shadow: 0 1px 3px var(--overlay);
        transition:
          background var(--transition-base),
          transform var(--transition-base);
      }

      &[aria-current="true"]::before {
        background: var(--on-ink);
        transform: scale(1.25);
      }
    }

    @media (min-width: 720px) {
      .media-carousel__slide {
        flex: 0 0 100%;
      }

      .media-carousel__nav {
        display: grid;
      }

      .media-carousel__dots {
        display: flex;
      }
    }
  }

  .media-carousel--hero.media-carousel--single,
  .media-carousel--hero .media-carousel__slide {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
  }

  /* Hero: one full-width slide at a time on every viewport (no peeking next
     slide at the top of the page); the dots signal the other photos. */
  .media-carousel--hero {
    .media-carousel__slide {
      flex-basis: 100%;
    }

    .media-carousel__dots {
      display: flex;
    }
  }
}
</style>
