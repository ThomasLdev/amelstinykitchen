---
import Kicker from "@components/Kicker.astro";

interface Props {
  kicker?: string;
  title: string;
  titleEm?: string;
  sub?: string;
  class?: string;
  [key: string]: unknown;
}

const { kicker, title, titleEm, sub, class: className, ...rest } = Astro.props;
---

<header class:list={["section-head", className]} {...rest}>
  <div class="section-head__titles">
    {kicker && <Kicker>{kicker}</Kicker>}
    <h2 class="section-head__title">
      {title}
      {titleEm && <em class="section-head__title-em">{titleEm}</em>}
    </h2>
    {sub && <p class="section-head__sub">{sub}</p>}
  </div>
  <slot name="action" />
</header>

<style>
@layer components {
  .section-head {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-block-end: var(--space-4);

    @media (min-width: 720px) {
      flex-direction: row;
      align-items: end;
      justify-content: space-between;
      gap: var(--space-4);
    }
  }

  .section-head__titles {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .section-head__title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 400;
    line-height: 1.1;
    color: var(--ink);
    text-wrap: balance;
  }

  .section-head__title-em {
    font-style: italic;
    font-weight: 300;
    color: var(--accent-ink);
    margin-inline-start: 0.5rem;
  }

  .section-head__sub {
    max-inline-size: 50ch;
    font-size: clamp(0.9375rem, 1.6vw, 1.0625rem);
    color: var(--ink-2);
    text-wrap: pretty;
  }
}
</style>
