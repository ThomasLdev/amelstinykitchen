---
import { renderMarkdown } from "@lib/content/markdown";

/** `markdown` is rendered to HTML; plain `text` is split into paragraphs on blank lines. */
type Props = ({ markdown: string; text?: never } | { text: string; markdown?: never }) & {
  class?: string;
  [key: string]: unknown;
};

const { markdown, text, class: className, ...rest } = Astro.props;
const html = markdown === undefined ? undefined : await renderMarkdown(markdown);
const paragraphs = text
  ?.split(/\n\s*\n/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);
---

<div class:list={["prose", className]} {...rest}>
  {html !== undefined ? (
    <Fragment set:html={html} />
  ) : (
    paragraphs?.map((paragraph) => <p>{paragraph}</p>)
  )}
</div>

<style>
@layer components {
  .prose {
    color: var(--ink-2);
    max-inline-size: var(--max-width-md);

    :global(h2) {
      margin-block-start: var(--space-4);
      font-family: var(--font-serif);
      font-size: clamp(1.375rem, 4vw, 1.75rem);
      font-weight: 400;
      line-height: 1.15;
      color: var(--ink);
    }

    :global(h3) {
      margin-block-start: var(--space-3);
      font-family: var(--font-serif);
      font-size: clamp(1.125rem, 3.6vw, 1.5rem);
      font-weight: 400;
      line-height: 1.2;
      color: var(--ink);
    }

    :global(p),
    :global(ul),
    :global(ol) {
      margin-block-start: 0.75rem;
    }

    & > :global(:first-child) {
      margin-block-start: 0;
    }

    :global(ul),
    :global(ol) {
      padding-inline-start: 1.25rem;
    }

    :global(ul) {
      list-style: disc;
    }

    :global(ol) {
      list-style: decimal;
    }

    :global(a) {
      color: var(--accent-ink);
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    :global(blockquote) {
      margin-block-start: var(--space-3);
      padding-inline-start: 1rem;
      border-inline-start: 2px solid var(--accent-soft);
      font-style: italic;
    }
  }
}
</style>
