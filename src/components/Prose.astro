---
interface Props {
  html: string;
  class?: string;
  [key: string]: unknown;
}

const { html, class: className, ...rest } = Astro.props;
---

<div class:list={["prose", className]} {...rest}>
  <Fragment set:html={html} />
</div>

<style>
@layer components {
  .prose {
    color: var(--ink-2);
    max-inline-size: var(--max-width-md);

    :global(h2) {
      margin-block-start: var(--space-4);
      font-family: var(--font-serif);
      font-size: clamp(1.375rem, 4vw, 1.75rem);
      font-weight: 400;
      line-height: 1.15;
      color: var(--ink);
    }

    :global(h3) {
      margin-block-start: var(--space-3);
      font-family: var(--font-serif);
      font-size: clamp(1.125rem, 3.6vw, 1.5rem);
      font-weight: 400;
      line-height: 1.2;
      color: var(--ink);
    }

    :global(p),
    :global(ul),
    :global(ol) {
      margin-block-start: 0.75rem;
    }

    :global(.prose > :first-child) {
      margin-block-start: 0;
    }

    :global(ul),
    :global(ol) {
      padding-inline-start: 1.25rem;
    }

    :global(ul) {
      list-style: disc;
    }

    :global(ol) {
      list-style: decimal;
    }

    :global(a) {
      color: var(--accent-ink);
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    :global(blockquote) {
      margin-block-start: var(--space-3);
      padding-inline-start: 1rem;
      border-inline-start: 2px solid var(--accent-soft);
      font-style: italic;
    }
  }
}
</style>
