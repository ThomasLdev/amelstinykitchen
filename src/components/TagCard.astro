---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  name: string;
  href: string;
  meta?: string;
  badge?: string;
  /** Decorative backdrop: the name already says what it shows. */
  image?: ImageMetadata;
  class?: string;
  [key: string]: unknown;
}

const { name, href, meta, badge, image, class: className, ...rest } = Astro.props;
const initial = name.charAt(0).toLocaleUpperCase();
---

<a
  class:list={["tag-card", badge && "tag-card--highlight", image && "tag-card--media", className]}
  href={href}
  {...rest}
>
  {image ? (
    <Picture
      src={image}
      alt=""
      formats={["avif", "webp"]}
      widths={[320, 480, 720, 960]}
      sizes="(min-width: 900px) 14rem, (min-width: 600px) 33vw, 100vw"
      class="tag-card__image"
      pictureAttributes={{ class: "tag-card__picture" }}
    />
  ) : (
    <span class="tag-card__initial" aria-hidden="true">
      {initial}
    </span>
  )}
  <h3 class="tag-card__name">{name}</h3>
  {badge && <span class="tag-card__badge">{badge}</span>}
  {meta && <span class="tag-card__meta">{meta}</span>}
</a>

<style>
@layer components {
  /* The badge follows the heading in the DOM so it is read with its own card. */
  .tag-card {
    display: grid;
    grid-template-areas:
      "name"
      "meta";
    align-content: start;
    gap: 0.125rem;
    block-size: 100%;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    transition: border-color var(--transition-base);

    &:hover {
      border-color: var(--ink);
    }

    @media (min-width: 600px) {
      grid-template-areas:
        "initial badge"
        "name name"
        "meta meta";
      grid-template-columns: auto 1fr;
      row-gap: 0.25rem;
      padding: 1.25rem;
    }
  }

  .tag-card--highlight {
    grid-template-areas:
      "badge meta"
      "name meta";
    grid-template-columns: 1fr auto;
    align-items: center;
    border-color: var(--ink);
    background: var(--ink);

    @media (min-width: 600px) {
      grid-template-areas:
        "initial badge"
        "name name"
        "meta meta";
      grid-template-columns: auto 1fr;
      align-items: stretch;
      border-color: var(--line);
      background: var(--surface);
    }
  }

  /* Text over a photo: a scrim keeps it readable, darker where the name sits. */
  .tag-card--media {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    align-content: end;
    min-block-size: 6.5rem;
    border-color: var(--ink);
    background: var(--ink);

    &::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      background: linear-gradient(to top, var(--scrim), var(--overlay));
    }

    @media (min-width: 600px) {
      grid-template-areas:
        "badge"
        "name"
        "meta";
      grid-template-columns: 1fr;
      grid-template-rows: 1fr auto auto;
      border-color: var(--ink);
      background: var(--ink);
    }
  }

  .tag-card__initial {
    display: none;
    grid-area: initial;
    align-items: center;
    justify-content: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    margin-block-end: 0.625rem;
    border-radius: 50%;
    background: var(--accent-bg);
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-style: italic;
    color: var(--accent-ink);

    @media (min-width: 600px) {
      display: inline-flex;
    }
  }

  .tag-card__badge {
    grid-area: badge;
    justify-self: start;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-soft);

    .tag-card--media & {
      margin-block-end: 0.25rem;
      padding: 0.25rem 0.625rem;
      border-radius: var(--radius-pill);
      background: var(--ink);
      color: var(--on-ink);
    }

    @media (min-width: 600px) {
      align-self: start;
      justify-self: end;
      padding: 0.25rem 0.625rem;
      border-radius: var(--radius-pill);
      background: var(--ink);
      color: var(--on-ink);

      .tag-card--media & {
        justify-self: start;
      }
    }
  }

  .tag-card__name {
    grid-area: name;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.2;
    color: var(--ink);

    .tag-card--highlight & {
      font-size: 1.375rem;
      color: var(--on-ink);
    }

    @media (min-width: 600px) {
      font-size: 1.375rem;

      .tag-card--highlight & {
        color: var(--ink);
      }

      .tag-card--media & {
        color: var(--on-ink);
      }
    }
  }

  .tag-card__meta {
    grid-area: meta;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-3);

    .tag-card--highlight & {
      color: var(--accent-soft);
    }

    @media (min-width: 600px) {
      font-size: 0.8125rem;

      .tag-card--highlight & {
        color: var(--ink-3);
      }

      .tag-card--media & {
        color: var(--on-ink-soft);
      }
    }
  }

  .tag-card__picture {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .tag-card__image {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    transition: transform var(--transition-zoom);

    .tag-card:hover & {
      transform: scale(1.04);
    }
  }
}
</style>
