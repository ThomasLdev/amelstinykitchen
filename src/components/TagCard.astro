---
interface Props {
  name: string;
  meta?: string;
  seasonLabel?: string;
  class?: string;
  [key: string]: unknown;
}

const { name, meta, seasonLabel, class: className, ...rest } = Astro.props;
const initial = name.charAt(0).toLocaleUpperCase();
---

<article class:list={["tag-card", seasonLabel && "tag-card--season", className]} {...rest}>
  <span class="tag-card__initial" aria-hidden="true">{initial}</span>
  <h3 class="tag-card__name">{name}</h3>
  {seasonLabel && <span class="tag-card__badge">{seasonLabel}</span>}
  {meta && <span class="tag-card__meta">{meta}</span>}
</article>

<style>
@layer components {
  /* The badge follows the heading in the DOM so it is read with its own card. */
  .tag-card {
    display: grid;
    grid-template-areas:
      "name"
      "meta";
    align-content: start;
    gap: 0.125rem;
    block-size: 100%;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);

    @media (min-width: 600px) {
      grid-template-areas:
        "initial badge"
        "name name"
        "meta meta";
      grid-template-columns: auto 1fr;
      row-gap: 0.25rem;
      padding: 1.25rem;
    }
  }

  .tag-card--season {
    grid-template-areas:
      "badge meta"
      "name meta";
    grid-template-columns: 1fr auto;
    align-items: center;
    border-color: var(--ink);
    background: var(--ink);

    @media (min-width: 600px) {
      grid-template-areas:
        "initial badge"
        "name name"
        "meta meta";
      grid-template-columns: auto 1fr;
      align-items: stretch;
      border-color: var(--line);
      background: var(--surface);
    }
  }

  .tag-card__initial {
    display: none;
    grid-area: initial;
    align-items: center;
    justify-content: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    margin-block-end: 0.625rem;
    border-radius: 50%;
    background: var(--accent-bg);
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-style: italic;
    color: var(--accent-ink);

    @media (min-width: 600px) {
      display: inline-flex;
    }
  }

  .tag-card__badge {
    grid-area: badge;
    justify-self: start;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-soft);

    @media (min-width: 600px) {
      align-self: start;
      justify-self: end;
      padding: 0.25rem 0.625rem;
      border-radius: var(--radius-pill);
      background: var(--ink);
      color: var(--on-ink);
    }
  }

  .tag-card__name {
    grid-area: name;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.2;
    color: var(--ink);

    .tag-card--season & {
      font-size: 1.375rem;
      color: var(--on-ink);
    }

    @media (min-width: 600px) {
      font-size: 1.375rem;

      .tag-card--season & {
        color: var(--ink);
      }
    }
  }

  .tag-card__meta {
    grid-area: meta;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-3);

    .tag-card--season & {
      color: var(--accent-soft);
    }

    @media (min-width: 600px) {
      font-size: 0.8125rem;

      .tag-card--season & {
        color: var(--ink-3);
      }
    }
  }
}
</style>
