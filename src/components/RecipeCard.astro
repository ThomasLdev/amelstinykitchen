---
import { Picture } from "astro:assets";
import { viewTransitionStyle } from "@lib/view-transition";
import type { ImageMetadata } from "astro";

interface Props {
  href: string;
  title: string;
  excerpt?: string;
  meta?: string;
  kicker?: string;
  image?: ImageMetadata;
  transitionName?: string;
  /** `list`: thumbnail row on phones; `tile`: always stacked (2-column grids). */
  variant?: "list" | "tile";
  /** Hooks for the recipes search: words to highlight and the matched-ingredients line. */
  searchable?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  title,
  excerpt,
  meta,
  kicker,
  image,
  transitionName,
  variant = "list",
  searchable = false,
  class: className,
  ...rest
} = Astro.props;

const sizes = {
  list: "(min-width: 1280px) 24rem, (min-width: 720px) 30vw, 6rem",
  tile: "(min-width: 1280px) 19rem, (min-width: 900px) 24vw, (min-width: 720px) 30vw, 46vw",
}[variant];

// The card is one link: name it by its title, not by every fact inside it.
const titleId = `recipe-card-${href.replace(/[^a-z0-9]+/gi, "-").replace(/^-|-$/g, "")}`;
const searchText = searchable ? { "data-search-text": "" } : {};
---

<a
  class:list={["recipe-card", variant !== "list" && `recipe-card--${variant}`, className]}
  href={href}
  aria-labelledby={titleId}
  {...rest}
>
  <div class="recipe-card__media" style={viewTransitionStyle(transitionName)}>
    {image && (
      <Picture
        src={image}
        alt=""
        formats={["avif", "webp"]}
        widths={[192, 360, 480, 720]}
        sizes={sizes}
        class="recipe-card__image"
      />
    )}
  </div>

  <div class="recipe-card__body">
    {kicker && (
      <p class="recipe-card__kicker" {...searchText}>
        {kicker}
      </p>
    )}
    {meta && <p class="recipe-card__meta">{meta}</p>}
    <h3 class="recipe-card__title" id={titleId} {...searchText}>{title}</h3>
    {excerpt && (
      <p class="recipe-card__excerpt" {...searchText}>
        {excerpt}
      </p>
    )}
    {searchable && <p class="recipe-card__match" data-search-match {...searchText} hidden />}
  </div>
</a>

<style>
@layer components {
  .recipe-card {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding-block: 0.75rem;
    color: inherit;
    text-decoration: none;

    @media (min-width: 720px) {
      flex-direction: column;
      align-items: stretch;
      padding-block: 0;
    }
  }

  .recipe-card__media {
    flex: none;
    inline-size: 6rem;
    aspect-ratio: 1;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--accent-bg);

    @media (min-width: 720px) {
      inline-size: 100%;
      aspect-ratio: 4 / 3;
    }
  }

  .recipe-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-zoom);

    .recipe-card:hover & {
      transform: scale(1.04);
    }
  }

  .recipe-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;

    @media (min-width: 720px) {
      gap: 0.375rem;
    }
  }

  .recipe-card__kicker {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-ink);

    @media (min-width: 720px) {
      font-size: 0.75rem;
    }
  }

  .recipe-card__match {
    order: 3;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-3);
  }

  /* Ranges set by the recipes search (CSS Custom Highlight API): no markup is added. */
  .recipe-card__kicker::highlight(recipe-search),
  .recipe-card__title::highlight(recipe-search),
  .recipe-card__excerpt::highlight(recipe-search),
  .recipe-card__match::highlight(recipe-search) {
    background-color: var(--accent-soft);
    color: var(--ink);
  }

  .recipe-card__meta {
    order: 1;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-3);

    @media (min-width: 720px) {
      order: 0;
      font-size: 0.8125rem;
    }
  }

  .recipe-card__title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.2;
    color: var(--ink);
    transition: color var(--transition-base);

    .recipe-card:hover & {
      color: var(--accent-ink);
    }

    @media (min-width: 720px) {
      font-size: 1.5rem;
    }
  }

  .recipe-card__excerpt {
    display: none;
    order: 2;
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--ink-2);

    @media (min-width: 720px) {
      display: block;
    }
  }

  .recipe-card--tile {
    flex-direction: column;
    align-items: stretch;
    gap: 0.5rem;
    padding-block: 0;

    @media (min-width: 720px) {
      gap: 0.75rem;
    }

    .recipe-card__media {
      inline-size: 100%;
    }

    .recipe-card__match {
      order: 3;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--ink-3);
    }

    /* Ranges set by the recipes search (CSS Custom Highlight API): no markup is added. */
    .recipe-card__kicker::highlight(recipe-search),
    .recipe-card__title::highlight(recipe-search),
    .recipe-card__excerpt::highlight(recipe-search),
    .recipe-card__match::highlight(recipe-search) {
      background-color: var(--accent-soft);
      color: var(--ink);
    }

    .recipe-card__meta {
      order: 1;
    }

    .recipe-card__title {
      font-size: 1.125rem;

      @media (min-width: 720px) {
        font-size: 1.375rem;
      }
    }
  }
}
</style>
