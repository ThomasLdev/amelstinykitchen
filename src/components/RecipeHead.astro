---
import Chip from "@components/Chip.astro";
import Icon from "@components/Icon.astro";
import IconButton from "@components/IconButton.astro";
import Kicker from "@components/Kicker.astro";
import { type Locale, useTranslations } from "@i18n";

interface Props {
  locale: Locale;
  title: string;
  isFeatured: boolean;
  tags?: string[];
  excerpt?: string;
  class?: string;
  [key: string]: unknown;
}

const { locale, title, isFeatured, tags = [], excerpt, class: className, ...rest } = Astro.props;
const t = useTranslations(locale);
---

<header class:list={["recipe-head", className]} {...rest}>
  <div class="recipe-head__lede">
    <h1 class="recipe-head__title">{title}</h1>

    {tags.length > 0 && (
      <ul class="recipe-head__tags">
        {tags.map((tag) => (
          <li>
            <Chip>{tag}</Chip>
          </li>
        ))}
      </ul>
    )}
  </div>

  <div class="recipe-head__aside">
    {excerpt && <p class="recipe-head__intro">{excerpt}</p>}

    <div class="recipe-head__actions">
      <IconButton aria-label={t.recipe.actions.print} data-recipe-action-print>
        <Icon name="printer" size={18} />
      </IconButton>
      <IconButton aria-label={t.recipe.actions.share} data-recipe-action-share>
        <Icon name="share-2" size={18} />
      </IconButton>
      <IconButton aria-label={t.recipe.actions.save}>
        <Icon name="bookmark" size={18} />
      </IconButton>
    </div>
  </div>
</header>

<style>
@layer components {
  .recipe-head {
    padding-block: var(--space-3) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);

    .recipe-head__title {
      margin-block-start: 0.75rem;
      font-family: var(--font-serif);
      font-size: clamp(2.125rem, 9vw, 4.5rem);
      font-weight: 400;
      line-height: 0.98;
      color: var(--ink);
      text-wrap: balance;
      padding: 1rem 0;
    }

    .recipe-head__tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.375rem;
      margin-block-start: 0.875rem;
      list-style: none;
    }

    .recipe-head__aside {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      margin-top: 1rem;
    }

    .recipe-head__intro {
      margin: 0;
      font-size: 0.9375rem;
      color: var(--ink-2);
    }

    .recipe-head__actions {
      display: flex;
      gap: 0.25rem;
    }

    @media (min-width: 720px) {
      display: grid;
      grid-template-columns: 1fr 1.2fr;
      gap: var(--space-5);
      align-items: end;
      padding-block: var(--space-4) var(--space-5);

      .recipe-head__intro {
        font-size: 1.0625rem;
      }

      .recipe-head__actions {
        justify-content: flex-end;
      }
    }
  }
}
</style>
