---
import Button from "@components/Button.astro";
import Chip from "@components/Chip.astro";
import Icon from "@components/Icon.astro";
import IconButton from "@components/IconButton.astro";
import Kicker from "@components/Kicker.astro";
import { type Locale, useTranslations } from "@i18n";

interface Props {
  locale: Locale;
  title: string;
  tags?: string[];
  excerpt?: string;
  /** Short context line (category, tags) shown instead of the tag chips on mobile. */
  kicker?: string;
  /** Fragment of the recipe body targeted by the "jump to recipe" link. */
  recipeAnchor?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  locale,
  title,
  tags = [],
  excerpt,
  kicker,
  recipeAnchor,
  class: className,
  ...rest
} = Astro.props;
const t = useTranslations(locale);
---

<header class:list={["recipe-head", className]} {...rest}>
  <div class="recipe-head__media">
    <slot name="media" />
  </div>

  <div class="recipe-head__lede">
    <div class="recipe-head__intro">
      {kicker && <Kicker class="recipe-head__kicker">{kicker}</Kicker>}
      <div class="recipe-head__title-row">
        <h1 class="recipe-head__title">{title}</h1>
        <IconButton
          variant="outline"
          class="recipe-head__title-share"
          aria-label={t.recipe.actions.share}
          data-recipe-action-share
        >
          <Icon name="share-2" size={18} />
        </IconButton>
      </div>
      {excerpt && <p class="recipe-head__excerpt">{excerpt}</p>}

      {tags.length > 0 && (
        <ul class="recipe-head__tags">
          {tags.map((tag) => (
            <li>
              <Chip>{tag}</Chip>
            </li>
          ))}
        </ul>
      )}
    </div>

    <slot name="stats" />

    <div class="recipe-head__actions">
      {recipeAnchor && (
        <Button href={`#${recipeAnchor}`}>
          {t.recipe.actions.jump}
          <Icon name="arrow-down" size={16} />
        </Button>
      )}
      <IconButton variant="outline" aria-label={t.recipe.actions.print} data-recipe-action-print>
        <Icon name="printer" size={18} />
      </IconButton>
      <IconButton variant="outline" aria-label={t.recipe.actions.share} data-recipe-action-share>
        <Icon name="share-2" size={18} />
      </IconButton>
    </div>
  </div>
</header>

<script>
import "@scripts/recipe/actions";
</script>

<style>
@layer components {
  .recipe-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block-end: var(--space-5);

    .recipe-head__lede {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      min-width: 0;
    }

    .recipe-head__intro {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .recipe-head__title {
      margin: 0;
      font-family: var(--font-serif);
      font-size: clamp(2.25rem, 7vw, 4rem);
      font-weight: 400;
      line-height: 1.02;
      letter-spacing: -0.01em;
      color: var(--ink);
      text-wrap: balance;
    }

    .recipe-head__excerpt {
      margin: 0;
      max-inline-size: 30em;
      font-size: 1.0625rem;
      line-height: 1.55;
      color: var(--ink-2);
    }

    /* Mobile: the kicker (category · tags) stands in for the chips to keep
       the hero compact. Share moves next to the title, so the actions row is
       desktop only. */
    .recipe-head__tags,
    .recipe-head__actions {
      display: none;
    }

    .recipe-head__title-row {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1rem;
    }

    .recipe-head__tags {
      flex-wrap: wrap;
      gap: 0.5rem;
      list-style: none;
    }

    .recipe-head__media {
      min-width: 0;
    }

    @media (min-width: 900px) {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      grid-template-areas: "lede media";
      align-items: center;
      gap: 0 var(--space-6);
      padding-block-end: var(--space-6);

      .recipe-head__lede {
        gap: var(--space-4);
      }

      .recipe-head__kicker {
        display: none;
      }

      .recipe-head__tags {
        display: flex;
      }

      .recipe-head__title-share {
        display: none;
      }

      .recipe-head__actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem;
      }

      .recipe-head__lede {
        grid-area: lede;
      }

      .recipe-head__media {
        grid-area: media;
      }

      .recipe-head__excerpt {
        font-size: 1.1875rem;
      }
    }
  }

  /* Print: title block beside a small cover, no actions. */
  .recipe-head {
    @media print {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 15rem;
      grid-template-areas: "lede media";
      align-items: start;
      gap: 1.5rem;
      padding-block: 0 1.5rem;
      break-inside: avoid;

      .recipe-head__lede {
        grid-area: lede;
        gap: 1rem;
      }

      .recipe-head__media {
        grid-area: media;
        align-self: start;
      }

      .recipe-head__title {
        font-size: 2.25rem;
      }

      .recipe-head__actions,
      .recipe-head__title-share {
        display: none;
      }
    }
  }
}
</style>
