---
import Chip from "@components/Chip.astro";
import Icon from "@components/Icon.astro";
import IconButton from "@components/IconButton.astro";
import Kicker from "@components/Kicker.astro";
import { type Locale, useTranslations } from "@i18n";

interface Props {
  locale: Locale;
  title: string;
  isFeatured: boolean;
  difficulty: string;
  stepsCount: number;
  ingredientsCount: number;
  tags?: string[];
  excerpt?: string;
  category?: { label: string; href: string };
  class?: string;
  [key: string]: unknown;
}

const {
  locale,
  title,
  isFeatured,
  difficulty,
  stepsCount,
  ingredientsCount,
  tags = [],
  excerpt,
  category,
  class: className,
  ...rest
} = Astro.props;
const t = useTranslations(locale);
---

<header class:list={["recipe-head", className]} {...rest}>
  <div class="recipe-head__lede">
    {isFeatured && <Kicker>{t.hero.badge}</Kicker>}
    <h1 class="recipe-head__title">{title}</h1>

    <div class="recipe-head__meta">
      {category && (
        <>
          <span>{category.label}</span>
          <span class="recipe-head__meta-dot" aria-hidden="true">
            ·
          </span>
        </>
      )}
      <span>{difficulty}</span>
      {stepsCount > 0 && (
        <>
          <span class="recipe-head__meta-dot" aria-hidden="true">
            ·
          </span>
          <span>{t.recipe.meta.steps(stepsCount)}</span>
        </>
      )}
      {ingredientsCount > 0 && (
        <>
          <span class="recipe-head__meta-dot" aria-hidden="true">
            ·
          </span>
          <span>{t.recipe.meta.ingredients(ingredientsCount)}</span>
        </>
      )}
    </div>

    {tags.length > 0 && (
      <ul class="recipe-head__tags">
        {tags.map((tag) => (
          <li>
            <Chip>{tag}</Chip>
          </li>
        ))}
      </ul>
    )}
  </div>

  <div>
    {excerpt && <p class="recipe-head__intro">{excerpt}</p>}

    <div class="recipe-head__author">
      <div class="recipe-head__avatar" aria-hidden="true">
        {t.recipe.author.initial}
      </div>
      <div>
        <div class="recipe-head__author-name">{t.recipe.author.name}</div>
        <div class="recipe-head__author-role">{t.recipe.author.role}</div>
      </div>
      <div class="recipe-head__actions">
        <IconButton aria-label={t.recipe.actions.print} data-recipe-action-print>
          <Icon name="printer" size={18} />
        </IconButton>
        <IconButton aria-label={t.recipe.actions.share} data-recipe-action-share>
          <Icon name="share-2" size={18} />
        </IconButton>
        <IconButton aria-label={t.recipe.actions.save}>
          <Icon name="bookmark" size={18} />
        </IconButton>
      </div>
    </div>
  </div>
</header>

<style>
@layer components {
  .recipe-head {
    padding-block: var(--space-3) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);

    .recipe-head__title {
      margin-block-start: 0.75rem;
      font-family: var(--font-serif);
      font-size: clamp(2.125rem, 9vw, 4.5rem);
      font-weight: 400;
      line-height: 0.98;
      color: var(--ink);
      text-wrap: balance;
    }

    .recipe-head__meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 0.75rem;
      margin-block-start: 0.875rem;
      font-family: var(--font-mono);
      font-size: 0.625rem;
      text-transform: uppercase;
      color: var(--ink-3);
    }

    .recipe-head__meta-dot {
      color: var(--accent);
    }

    .recipe-head__intro {
      margin: 0;
      font-size: 0.9375rem;
      color: var(--ink-2);
    }

    .recipe-head__tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.375rem;
      margin-block-start: 0.875rem;
      list-style: none;
    }

    .recipe-head__author {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding-block-start: 1rem;
      border-top: 1px solid var(--line);
    }

    .recipe-head__avatar {
      width: 2.625rem;
      height: 2.625rem;
      border-radius: 50%;
      background: var(--accent-soft);
      display: grid;
      place-items: center;
      font-family: var(--font-serif);
      font-style: italic;
      color: var(--accent-ink);
      font-size: 1.125rem;
      flex-shrink: 0;
    }

    .recipe-head__author-name {
      font-weight: 500;
      font-size: 0.875rem;
    }

    .recipe-head__author-role {
      font-family: var(--font-mono);
      font-size: 0.625rem;
      text-transform: uppercase;
      color: var(--ink-3);
    }

    .recipe-head__actions {
      margin-inline-start: auto;
      display: flex;
      gap: 0.25rem;
    }

    @media (min-width: 720px) {
      display: grid;
      grid-template-columns: 1fr 1.2fr;
      gap: var(--space-5);
      align-items: end;
      padding-block: var(--space-4) var(--space-5);

      .recipe-head__intro {
        font-size: 1.0625rem;
      }
    }
  }
}
</style>
