---
import Button from "@components/Button.astro";
import Chip from "@components/Chip.astro";
import Icon from "@components/Icon.astro";
import IconButton from "@components/IconButton.astro";
import { type Locale, useTranslations } from "@i18n";

interface Props {
  locale: Locale;
  title: string;
  tags?: string[];
  excerpt?: string;
  /** Fragment of the recipe body targeted by the "jump to recipe" link. */
  recipeAnchor?: string;
  class?: string;
  [key: string]: unknown;
}

const { locale, title, tags = [], excerpt, recipeAnchor, class: className, ...rest } = Astro.props;
const t = useTranslations(locale);
---

<header class:list={["recipe-head", className]} {...rest}>
  <div class="recipe-head__lede">
    <slot name="breadcrumb" />

    <div class="recipe-head__intro">
      <h1 class="recipe-head__title">{title}</h1>
      {excerpt && <p class="recipe-head__excerpt">{excerpt}</p>}

      {tags.length > 0 && (
        <ul class="recipe-head__tags">
          {tags.map((tag) => (
            <li>
              <Chip>{tag}</Chip>
            </li>
          ))}
        </ul>
      )}
    </div>

    <slot name="stats" />

    <div class="recipe-head__actions">
      {recipeAnchor && (
        <Button href={`#${recipeAnchor}`}>
          {t.recipe.actions.jump}
          <Icon name="arrow-down" size={16} />
        </Button>
      )}
      <Button variant="ghost">
        <Icon name="bookmark" size={16} />
        {t.recipe.actions.save}
      </Button>
      <IconButton variant="outline" aria-label={t.recipe.actions.print} data-recipe-action-print>
        <Icon name="printer" size={18} />
      </IconButton>
      <IconButton variant="outline" aria-label={t.recipe.actions.share} data-recipe-action-share>
        <Icon name="share-2" size={18} />
      </IconButton>
    </div>
  </div>

  <div class="recipe-head__media">
    <slot name="media" />
  </div>
</header>

<style>
@layer components {
  .recipe-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block: var(--space-2) var(--space-5);

    .recipe-head__lede {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      min-width: 0;
    }

    .recipe-head__intro {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .recipe-head__title {
      margin: 0;
      font-family: var(--font-serif);
      font-size: clamp(2.25rem, 7vw, 4rem);
      font-weight: 400;
      line-height: 1.02;
      letter-spacing: -0.01em;
      color: var(--ink);
      text-wrap: balance;
    }

    .recipe-head__excerpt {
      margin: 0;
      max-inline-size: 30em;
      font-size: 1.0625rem;
      line-height: 1.55;
      color: var(--ink-2);
    }

    .recipe-head__tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      list-style: none;
    }

    .recipe-head__actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.75rem;
    }

    .recipe-head__media {
      min-width: 0;
    }

    @media (min-width: 900px) {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: center;
      gap: var(--space-6);
      padding-block: var(--space-4) var(--space-6);

      .recipe-head__lede {
        gap: var(--space-4);
      }

      .recipe-head__excerpt {
        font-size: 1.1875rem;
      }
    }
  }
}
</style>
