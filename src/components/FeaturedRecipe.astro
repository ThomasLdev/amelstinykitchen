---
import { Picture } from "astro:assets";
import Icon from "@components/Icon.astro";
import { viewTransitionStyle } from "@lib/view-transition";
import type { ImageMetadata } from "astro";

interface Props {
  href: string;
  title: string;
  meta?: string;
  badge?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  transitionName?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  title,
  meta,
  badge,
  image,
  imageAlt = "",
  transitionName,
  class: className,
  ...rest
} = Astro.props;

// The card is one link: name it by its title, not by every fact inside it.
const titleId = `featured-${href.replace(/[^a-z0-9]+/gi, "-").replace(/^-|-$/g, "")}`;
---

<article class:list={["featured", className]} {...rest}>
  <a class="featured__link" href={href} aria-labelledby={titleId}>
    <div class="featured__media" style={viewTransitionStyle(transitionName)}>
      {image && (
        <Picture
          src={image}
          alt={imageAlt}
          formats={["avif", "webp"]}
          widths={[480, 720, 960]}
          sizes="(min-width: 720px) 30rem, 92vw"
          priority
          class="featured__image"
        />
      )}
      {badge && <span class="featured__badge">{badge}</span>}
    </div>
    <div class="featured__body">
      {meta && <p class="featured__meta">{meta}</p>}
      <div class="featured__row">
        <h2 class="featured__title" id={titleId}>{title}</h2>
        <span class="featured__arrow">
          <Icon name="arrow-right" size={18} />
        </span>
      </div>
    </div>
  </a>
</article>

<style>
@layer components {
  .featured {
    padding: 0.625rem;
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-card);

    @media (min-width: 720px) {
      padding: 0.75rem;
    }
  }

  .featured__link {
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }

  .featured__media {
    position: relative;
    aspect-ratio: 5 / 4;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--accent-bg);
  }

  .featured__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-zoom);

    .featured__link:hover & {
      transform: scale(1.03);
    }
  }

  .featured__badge {
    position: absolute;
    inset-block-start: 0.75rem;
    inset-inline-start: 0.75rem;
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--on-ink);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .featured__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.875rem 0.5rem 0.5rem;

    @media (min-width: 720px) {
      padding: 1.125rem 0.75rem 0.75rem;
    }
  }

  .featured__meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink-3);
  }

  .featured__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .featured__title {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 1.75rem);
    font-weight: 400;
    line-height: 1.15;
    color: var(--ink);
    transition: color var(--transition-base);

    .featured__link:hover & {
      color: var(--accent-ink);
    }
  }

  .featured__arrow {
    display: none;
    flex: none;
    align-items: center;
    justify-content: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border-radius: 50%;
    background: var(--accent-bg);
    color: var(--ink);

    @media (min-width: 720px) {
      display: inline-flex;
    }
  }
}
</style>
