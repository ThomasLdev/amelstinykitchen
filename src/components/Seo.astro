---
import { getAbsoluteLocaleUrl } from "astro:i18n";
import { defaultLocale, type Locale } from "@i18n";
import type { SocialImage } from "@lib/seo/images";
import { serializeJsonLd } from "@lib/seo/jsonld";
import { siteConfig } from "@site";

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  /** Locale-relative path of this page in every locale it exists in (hreflang). */
  alternates?: Partial<Record<Locale, string>>;
  image?: SocialImage;
  type?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
  jsonLd?: Record<string, unknown>[];
  /** Absolute URL of a Markdown version of the page, for agents. */
  markdownUrl?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  locale,
  alternates = {},
  image,
  type = "website",
  publishedTime,
  modifiedTime,
  jsonLd = [],
  markdownUrl,
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL(Astro.url.origin);
const ownPath = alternates[locale];
const canonical =
  ownPath !== undefined
    ? getAbsoluteLocaleUrl(locale, ownPath)
    : new URL(Astro.url.pathname, site).href;

const languages = Object.entries(alternates) as [Locale, string][];
const hreflangs = languages.map(([lang, path]) => ({
  lang,
  href: getAbsoluteLocaleUrl(lang, path),
}));
const xDefault = hreflangs.find(({ lang }) => lang === defaultLocale);
const otherOgLocales = languages
  .filter(([lang]) => lang !== locale)
  .map(([lang]) => siteConfig.ogLocale[lang]);

const robots = noindex ? "noindex, follow" : "index, follow, max-image-preview:large";
const rssUrl = new URL("rss.xml", getAbsoluteLocaleUrl(locale, "")).href;
---

<title>{title}</title>
{description && <meta name="description" content={description} />}
<meta name="robots" content={robots}>
{!noindex && <link rel="canonical" href={canonical} />}

{!noindex &&
  hreflangs.map(({ lang, href }) => <link rel="alternate" hreflang={lang} href={href} />)}
{!noindex && xDefault && <link rel="alternate" hreflang="x-default" href={xDefault.href} />}

<meta property="og:site_name" content={siteConfig.name}>
<meta property="og:title" content={title}>
{description && <meta property="og:description" content={description} />}
{!noindex && <meta property="og:url" content={canonical} />}
<meta property="og:type" content={type}>
<meta property="og:locale" content={siteConfig.ogLocale[locale]}>
{otherOgLocales.map((ogLocale) => <meta property="og:locale:alternate" content={ogLocale} />)}
{image && (
  <>
    <meta property="og:image" content={image.url} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={image.alt} />
  </>
)}
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<meta name="twitter:card" content={image ? "summary_large_image" : "summary"}>
<meta name="twitter:title" content={title}>
{description && <meta name="twitter:description" content={description} />}
{image && <meta name="twitter:image" content={image.url} />}
{image && <meta name="twitter:image:alt" content={image.alt} />}

{siteConfig.pinterestDomainVerify && (
  <meta name="p:domain_verify" content={siteConfig.pinterestDomainVerify} />
)}
<meta name="theme-color" content={siteConfig.themeColor}>
<link rel="alternate" type="application/rss+xml" title={siteConfig.name} href={rssUrl}>
{markdownUrl && <link rel="alternate" type="text/markdown" href={markdownUrl} />}

{jsonLd.map((data) => (
  <script type="application/ld+json" is:inline set:html={serializeJsonLd(data)} />
))}
