---
import RecipeCard from "@components/RecipeCard.astro";

type Item = Parameters<typeof RecipeCard>[0];

interface Props {
  items: Item[];
  variant?: Item["variant"];
  class?: string;
  [key: string]: unknown;
}

const { items, variant = "list", class: className, ...rest } = Astro.props;
---

<ul
  class:list={["recipe-grid", variant !== "list" && `recipe-grid--${variant}`, className]}
  {...rest}
>
  {items.map((item) => (
    <li class="recipe-grid__item">
      <RecipeCard {...item} variant={variant} />
    </li>
  ))}
</ul>

<style>
@layer components {
  .recipe-grid {
    display: flex;
    flex-direction: column;

    @media (min-width: 720px) {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
      align-items: start;
    }

    &.recipe-grid--tile {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem 0.75rem;
      align-items: start;

      @media (min-width: 720px) {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 2rem 1.5rem;
      }
    }
  }

  .recipe-grid:not(.recipe-grid--tile) .recipe-grid__item:not(:last-child) {
    border-block-end: 1px solid var(--line);

    @media (min-width: 720px) {
      border-block-end: none;
    }
  }
}
</style>
