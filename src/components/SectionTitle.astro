---
interface Props {
  title: string;
  titleEm?: string;
  class?: string;
  [key: string]: unknown;
}

const { title, titleEm, class: className, ...rest } = Astro.props;
---

<h2 class:list={["section-title", className]} {...rest}>
  {titleEm ? `${title} ` : title}
  {titleEm && <em class="section-title__em">{titleEm}</em>}
</h2>

<style>
@layer components {
  .section-title {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.625rem, 4vw, 2.5rem);
    font-weight: 400;
    line-height: 1.05;
    color: var(--ink);
    text-wrap: balance;
  }

  .section-title__em {
    font-weight: 300;
    color: var(--accent-ink);
  }
}
</style>
