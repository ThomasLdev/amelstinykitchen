---
import { Picture } from "astro:assets";
import Button from "@components/Button.astro";
import Chip from "@components/Chip.astro";
import Icon from "@components/Icon.astro";
import Kicker from "@components/Kicker.astro";
import type { ImageMetadata } from "astro";

interface Props {
  kicker?: string;
  badge?: string;
  title: string;
  description?: string;
  prep?: string;
  cook?: string;
  total?: string;
  prepLabel?: string;
  cookLabel?: string;
  totalLabel?: string;
  tags?: readonly string[];
  ctaHref: string;
  ctaLabel: string;
  image?: ImageMetadata;
  imageAlt?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  kicker,
  badge,
  title,
  description,
  prep,
  cook,
  total,
  prepLabel,
  cookLabel,
  totalLabel,
  tags = [],
  ctaHref,
  ctaLabel,
  image,
  imageAlt = "",
  class: className,
  ...rest
} = Astro.props;

const rawMeta = [
  { icon: "utensils-crossed", label: prepLabel, value: prep },
  { icon: "flame", label: cookLabel, value: cook },
  { icon: "clock", label: totalLabel, value: total },
];
const metaItems = rawMeta.filter((item) => item.value) as {
  icon: string;
  label?: string;
  value: string;
}[];
---

<article class:list={["hero", className]} {...rest}>
  <div class="hero__media">
    {image && (
      <Picture
        src={image}
        alt={imageAlt}
        formats={["avif", "webp"]}
        widths={[480, 720, 960, 1280]}
        sizes="(min-width: 1280px) 42rem, (min-width: 720px) 52vw, 92vw"
        priority
        class="hero__cover"
      />
    )}
    {badge && <span class="hero__badge">{badge}</span>}
  </div>

  <div class="hero__body">
    {kicker && <Kicker>{kicker}</Kicker>}
    <h1 class="hero__title">{title}</h1>
    {description && <p class="hero__desc">{description}</p>}

    {metaItems.length > 0 && (
      <dl class="hero__meta">
        {metaItems.map((item) => (
          <div class="hero__meta-item">
            <span class="hero__meta-icon">
              <Icon name={item.icon} size={22} />
            </span>
            {item.label && <dt class="hero__meta-label">{item.label}</dt>}
            <dd class="hero__meta-value">{item.value}</dd>
          </div>
        ))}
      </dl>
    )}

    {tags.length > 0 && (
      <ul class="hero__tags">
        {tags.map((tag) => (
          <li>
            <Chip>{tag}</Chip>
          </li>
        ))}
      </ul>
    )}

    <div class="hero__cta">
      <Button variant="primary" href={ctaHref}>
        {ctaLabel}
        <Icon name="arrow-right" size={14} />
      </Button>
    </div>
  </div>
</article>

<style>
@layer components {
  .hero {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 1rem 0;
    padding: 0.75rem;
    border-radius: 22px;
    background: var(--surface);
    box-shadow: var(--shadow-card);
    overflow: hidden;

    @media (min-width: 720px) {
      flex-direction: row;
      gap: 0;
      margin: 2rem 0;
      padding: 1rem;
    }
  }

  .hero__media {
    position: relative;
    order: 1;
    aspect-ratio: 4 / 5;
    border-radius: 16px;
    overflow: hidden;
    background: var(--accent-soft);

    @media (min-width: 720px) {
      order: 2;
      flex: 1.2;
      aspect-ratio: auto;
      min-height: 28.75rem;
      border-radius: 18px;
    }

    @media (min-width: 1200px) {
      min-height: 33.75rem;
    }
  }

  .hero__cover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__badge {
    position: absolute;
    inset-block-start: 0.875rem;
    inset-inline-end: 0.875rem;
    padding-block: 0.375rem;
    padding-inline: 0.75rem;
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--on-ink);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    text-transform: uppercase;
  }

  .hero__body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    order: 2;
    padding: 1rem 0.75rem 1.125rem;

    @media (min-width: 720px) {
      order: 1;
      flex: 1;
      gap: 1.125rem;
      padding: 1.75rem 1.75rem 1.375rem;
    }

    @media (min-width: 1200px) {
      padding: 2.5rem 2.25rem 2rem;
    }
  }

  .hero__title {
    font-family: var(--font-serif);
    font-size: clamp(2.125rem, 9vw, 3.5rem);
    font-weight: 400;
    line-height: 1.05;
    color: var(--ink);
    text-wrap: balance;

    @media (min-width: 720px) {
      font-size: clamp(2.375rem, 4.4vw, 3.5rem);
    }
  }

  .hero__desc {
    font-size: 0.9375rem;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.125rem;
    padding-block-start: 0.25rem;
    margin: 0;

    @media (min-width: 1200px) {
      justify-content: flex-start;
    }
  }

  .hero__meta-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    min-width: 4.875rem;
  }

  .hero__meta-icon {
    display: inline-flex;
    margin-block-end: 0.25rem;
    color: var(--accent-ink);
  }

  .hero__meta-label {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .hero__meta-value {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--ink);
  }

  .hero__tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-block-end: 1rem;

    @media (min-width: 1200px) {
      justify-content: flex-start;
    }
  }

  .hero__cta {
    width: 100%;
    display: flex;
    justify-content: center;
    margin-top: 1rem;

    @media (min-width: 720px) {
      width: auto;
      align-self: flex-start;
      margin-block-start: auto;
    }
  }
}
</style>
