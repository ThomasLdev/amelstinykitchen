---
import Icon from "@components/Icon.astro";

interface Option {
  value: string;
  label: string;
  count?: number;
}

interface Props {
  type: "radio" | "checkbox";
  name: string;
  legend: string;
  options: Option[];
  /**
   * Phone look → desktop (≥ 900px) look:
   * `list`: pills with counts → stacked rows; `segmented`: segmented track →
   * pills; `switch`: switch rows → check pills.
   */
  appearance: "list" | "segmented" | "switch";
  class?: string;
  [key: string]: unknown;
}

const { type, name, legend, options, appearance, class: className, ...rest } = Astro.props;
---

<fieldset class:list={["filter-group", `filter-group--${appearance}`, className]} {...rest}>
  <legend class="filter-group__legend">{legend}</legend>
  <div class="filter-group__options">
    {options.map((option, index) => (
      <label class="filter-group__option">
        <input
          class="filter-group__input"
          type={type}
          name={name}
          value={option.value}
          checked={type === "radio" && index === 0}
        />
        {appearance === "switch" && <Icon name="check" size={14} class="filter-group__check" />}
        <span class="filter-group__label">{option.label}</span>
        {option.count !== undefined && (
          <span class="filter-group__count" data-filter-count={option.value}>
            {option.count}
          </span>
        )}
        {appearance === "switch" && <span class="filter-group__switch" aria-hidden="true" />}
      </label>
    ))}
  </div>
</fieldset>

<style>
@layer components {
  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-inline-size: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .filter-group__legend {
    margin-block-end: 0.75rem;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }

  .filter-group__options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-group__option {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 2.75rem;
    padding-inline: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    font-size: 0.9375rem;
    color: var(--ink);
    cursor: pointer;
    transition:
      background var(--transition-base),
      border-color var(--transition-base),
      color var(--transition-base);

    &:hover {
      border-color: var(--accent-ink);
    }

    &:has(.filter-group__input:focus-visible) {
      outline: 2px solid var(--accent-ink);
      outline-offset: 3px;
    }

    @media (forced-colors: active) {
      &:has(.filter-group__input:checked) {
        outline: 2px solid Highlight;
      }
    }
  }

  /* The whole option is the hit area; the native input stays in the a11y tree. */
  .filter-group__input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .filter-group__count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-3);
  }

  .filter-group__check,
  .filter-group__switch {
    display: none;
  }

  .filter-group--list {
    .filter-group__option:has(.filter-group__input:checked) {
      border-color: var(--ink);
      background: var(--ink);
      color: var(--on-ink);

      .filter-group__count {
        color: var(--on-ink-muted);
      }
    }

    @media (min-width: 900px) {
      .filter-group__legend {
        margin-block-end: 0.25rem;
      }

      .filter-group__options {
        flex-direction: column;
        gap: 0.25rem;
      }

      .filter-group__option {
        justify-content: space-between;
        padding-inline: 0.875rem;
        border-color: transparent;
        border-radius: var(--radius-md);

        &:hover {
          border-color: transparent;
          background: var(--bg-deep);
        }
      }

      .filter-group__option:has(.filter-group__input:checked):hover {
        background: var(--ink);
      }
    }
  }

  .filter-group--segmented {
    .filter-group__options {
      display: grid;
      grid-auto-columns: minmax(0, 1fr);
      grid-auto-flow: column;
      gap: 0;
      padding: 0.1875rem;
      border-radius: var(--radius-md);
      background: var(--bg-deep);
    }

    .filter-group__option {
      justify-content: center;
      padding-inline: 0.25rem;
      border-color: transparent;
      border-radius: var(--radius-sm);
      font-size: 0.8125rem;
      color: var(--ink-2);
      text-align: center;
    }

    .filter-group__option:has(.filter-group__input:checked) {
      border-color: var(--ink-3);
      background: var(--surface);
      color: var(--ink);
      font-weight: 500;
      box-shadow: var(--shadow-soft);
    }

    @media (min-width: 900px) {
      .filter-group__options {
        display: flex;
        gap: 0.5rem;
        padding: 0;
        background: none;
      }

      .filter-group__option {
        padding-inline: 1rem;
        border: 1px solid var(--line);
        border-radius: var(--radius-pill);
        font-size: 0.875rem;
        font-weight: 400;
        color: var(--ink);
        box-shadow: none;
      }

      .filter-group__option:has(.filter-group__input:checked) {
        border-color: var(--ink);
        background: var(--ink);
        color: var(--on-ink);
        font-weight: 400;
        box-shadow: none;
      }
    }
  }

  .filter-group--switch {
    .filter-group__options {
      flex-direction: column;
      gap: 0;
    }

    .filter-group__option {
      justify-content: space-between;
      min-block-size: 3.25rem;
      padding-inline: 0;
      border: 0;
      border-block-end: 1px solid var(--line);
      border-radius: 0;
      font-size: 1rem;
    }

    .filter-group__switch {
      display: block;
      flex: none;
      inline-size: 3.125rem;
      block-size: 1.875rem;
      padding: 2px;
      border-radius: var(--radius-pill);
      background: var(--line);
      box-shadow: inset 0 0 0 1px var(--ink-3);
      transition: background var(--transition-base);

      &::before {
        content: "";
        display: block;
        inline-size: 1.625rem;
        block-size: 1.625rem;
        border-radius: 50%;
        background: var(--surface);
        box-shadow: var(--shadow-soft);
        transition: translate var(--transition-base);
      }
    }

    .filter-group__option:has(.filter-group__input:checked) .filter-group__switch {
      background: var(--accent-ink);

      &::before {
        translate: 1.25rem 0;
      }
    }

    @media (min-width: 900px) {
      .filter-group__options {
        flex-direction: row;
        gap: 0.5rem;
      }

      .filter-group__option {
        justify-content: flex-start;
        gap: 0.375rem;
        min-block-size: 2.75rem;
        padding-inline: 1rem;
        border: 1px solid var(--line);
        border-radius: var(--radius-pill);
        font-size: 0.875rem;
      }

      .filter-group__switch {
        display: none;
      }

      .filter-group__option:has(.filter-group__input:checked) {
        padding-inline-start: 0.75rem;
        border-color: var(--accent);
        background: var(--accent-bg);
        color: var(--ink);

        .filter-group__check {
          display: inline-block;
        }
      }
    }
  }
}
</style>
