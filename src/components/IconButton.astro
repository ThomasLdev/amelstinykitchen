---
interface Props {
  class?: string;
  [key: string]: unknown;
}

const { class: className, ...rest } = Astro.props;
---

<button type="button" class:list={["icon-btn", className]} {...rest}>
  <slot />
</button>

<style>
@layer components {
  .icon-btn {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    color: var(--ink-2);
    flex-shrink: 0;
    transition:
      background var(--transition-base),
      color var(--transition-base);

    &:hover {
      background: var(--accent-bg);
      color: var(--accent-ink);
    }
  }
}
</style>
