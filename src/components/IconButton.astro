---
interface Props {
  variant?: "default" | "outline";
  class?: string;
  [key: string]: unknown;
}

const { variant = "default", class: className, ...rest } = Astro.props;
---

<button
  type="button"
  class:list={["icon-btn", variant !== "default" && `icon-btn--${variant}`, className]}
  {...rest}
>
  <slot />
</button>

<style>
@layer components {
  .icon-btn {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    color: var(--ink-2);
    flex-shrink: 0;
    transition:
      background var(--transition-base),
      border-color var(--transition-base),
      color var(--transition-base);

    &:hover {
      background: var(--accent-bg);
      color: var(--accent-ink);
    }

    &.icon-btn--outline {
      width: 3rem;
      height: 3rem;
      border: 1px solid var(--line);
      color: var(--ink);

      &:hover {
        border-color: var(--accent);
      }
    }
  }
}
</style>
