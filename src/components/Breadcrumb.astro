---
interface Item {
  label: string;
  /** Omitted while the target page does not exist yet: the crumb is plain text. */
  href?: string;
}

interface Props {
  items: Item[];
  current?: string;
  label?: string;
  class?: string;
  [key: string]: unknown;
}

const { items, current, label, class: className, ...rest } = Astro.props;
---

<nav class:list={["breadcrumb", className]} aria-label={label} {...rest}>
  <ol class="breadcrumb__list">
    {items.map((item) => (
      <li class="breadcrumb__item">
        {item.href ? (
          <a href={item.href} class="breadcrumb__link">
            {item.label}
          </a>
        ) : (
          item.label
        )}
        <span class="breadcrumb__sep" aria-hidden="true">
          /
        </span>
      </li>
    ))}
    {current && (
      <li class="breadcrumb__item breadcrumb__item--current" aria-current="page">
        {current}
      </li>
    )}
  </ol>
</nav>

<style>
@layer components {
  .breadcrumb {
    overflow-x: auto;
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none;
    }

    .breadcrumb__list {
      display: flex;
      flex-wrap: nowrap;
      align-items: center;
      gap: 0.5rem;
      list-style: none;
      white-space: nowrap;
      font-family: var(--font-mono);
      font-size: 0.625rem;
      text-transform: uppercase;
      color: var(--ink-3);
    }

    .breadcrumb__item {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }

    .breadcrumb__item--current {
      color: var(--ink);
    }

    .breadcrumb__link {
      color: var(--ink-3);
      transition: color var(--transition-fast);

      &:hover {
        color: var(--accent-ink);
      }
    }

    .breadcrumb__sep {
      color: var(--accent);
    }
  }
}
</style>
