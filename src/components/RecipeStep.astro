---
import Icon from "@components/Icon.astro";
import MediaCarousel from "@components/MediaCarousel.astro";
import Prose from "@components/Prose.astro";
import { type Locale, useTranslations } from "@i18n";
import type { ImageMetadata } from "astro";

/** Renders an `<li>`: place it in an `<ol>`. Its `id` (`step-N`) is the HowToStep URL in JSON-LD. */
interface Props {
  index: number;
  title: string;
  content: string;
  tip?: { type: "tip" | "warning"; text: string };
  media?: { src: ImageMetadata; alt: string }[];
  locale: Locale;
  class?: string;
  [key: string]: unknown;
}

const { index, title, content, tip, media, locale, class: className, ...rest } = Astro.props;
const t = useTranslations(locale);
const number = String(index).padStart(2, "0");
const tipWarning = tip?.type === "warning";
---

<li class="step-item" id={`step-${index}`}>
  <article class:list={["step", className]} {...rest}>
    <span class="step__num" aria-hidden="true">{number}</span>

    <div class="step__body">
      {title && <h3 class="step__title">{title}</h3>}
      {content && <Prose markdown={content} class="step__content" />}

      {media && media.length > 0 && (
        <div class="step__media">
          <MediaCarousel
            media={media}
            locale={locale}
            sizes={`(min-width: 600px) 34rem, ${media.length > 1 ? "78vw" : "92vw"}`}
            widths={[480, 720, 960]}
          />
        </div>
      )}

      {tip && (
        <aside class:list={["step__tip", tipWarning && "step__tip--warning"]}>
          <Icon
            name={tipWarning ? "triangle-alert" : "lightbulb"}
            class="step__tip-icon"
            size={20}
          />
          <p class="step__tip-text">
            <strong class="step__tip-label">
              {tipWarning ? t.recipe.steps.warning : t.recipe.steps.tip}
            </strong>
            {tip.text}
          </p>
        </aside>
      )}
    </div>
  </article>
</li>

<style>
@layer components {
  .step-item {
    border-bottom: 1px solid var(--line);

    &:last-of-type {
      border-bottom: 0;
    }
  }

  .step {
    /* Mobile: number and title share the first row; the body's other
       children (text, media, tip) span the full width underneath. */
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: baseline;
    gap: 0.75rem;
    padding-block: 1.25rem;

    .step__num {
      font-family: var(--font-serif);
      font-style: italic;
      font-weight: 300;
      font-size: clamp(2rem, 5vw, 2.25rem);
      color: var(--accent);
      line-height: 1;
    }

    .step__body {
      display: contents;
    }

    .step__title {
      margin: 0;
    }

    .step__content,
    .step__media,
    .step__tip {
      grid-column: 1 / -1;
    }

    .step__content {
      color: var(--ink-2);
      font-size: 0.9375rem;
    }

    .step__media {
      max-inline-size: var(--max-width-sm);
    }

    .step__tip {
      background: var(--accent-bg);
      border-radius: var(--radius-md);
      padding: 0.875rem 1rem;
      display: flex;
      gap: 0.75rem;
      align-items: flex-start;
      max-inline-size: var(--max-width-sm);
    }

    .step__tip--warning {
      background: color-mix(in oklab, var(--accent-bg) 70%, var(--accent-soft));
    }

    .step__tip-icon {
      width: 1.25rem;
      height: 1.25rem;
      color: var(--accent-ink);
      flex-shrink: 0;
      margin-block-start: 0.125rem;
    }

    .step__tip-text {
      margin: 0;
      font-size: 0.875rem;
      color: var(--accent-ink);
    }

    .step__tip-label {
      font-family: var(--font-serif);
      font-style: italic;
      font-weight: 400;
      margin-inline-end: 0.25rem;
    }

    @media (min-width: 720px) {
      grid-template-columns: 5rem minmax(0, 1fr);
      gap: 1.25rem;
      padding-block: 1.75rem;
      align-items: start;

      .step__num {
        font-size: 2.75rem;
      }

      .step__body {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }

      .step__content,
      .step__media,
      .step__tip {
        grid-column: auto;
      }
    }
  }

  .step {
    /* Print: text on the left, photo in a narrow column on the right. */
    @media print {
      break-inside: avoid;
      padding-block: 1rem;

      .step__body {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 11rem;
        align-content: start;
        gap: 0.5rem 1.25rem;
      }

      .step__title,
      .step__content,
      .step__tip {
        grid-column: 1;
      }

      .step__media {
        grid-column: 2;
        grid-row: 1 / span 3;
      }

      .step__tip {
        border: 1px solid var(--accent-soft);
      }
    }
  }
}
</style>
