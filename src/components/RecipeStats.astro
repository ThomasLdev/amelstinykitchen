---
interface Props {
  prepLabel: string;
  cookLabel: string;
  totalLabel: string;
  difficultyLabel: string;
  difficultyValue: string;
  preparationTime?: string | null;
  cookingTime?: string | null;
  totalTime?: string | null;
  /** ISO 8601 durations (`PT40M`) for the `<time datetime>` of each value. */
  datetimes?: { preparation?: string; cooking?: string; total?: string };
  class?: string;
  [key: string]: unknown;
}

const {
  prepLabel,
  cookLabel,
  totalLabel,
  difficultyLabel,
  difficultyValue,
  preparationTime,
  cookingTime,
  totalTime,
  datetimes = {},
  class: className,
  ...rest
} = Astro.props;

const items = [
  { label: prepLabel, value: preparationTime, datetime: datetimes.preparation },
  { label: cookLabel, value: cookingTime, datetime: datetimes.cooking },
  { label: totalLabel, value: totalTime, datetime: datetimes.total },
  { label: difficultyLabel, value: difficultyValue, datetime: undefined },
].filter((item) => item.value);
---

<div class:list={["recipe-stats", className]} {...rest}>
  <dl class="recipe-stats__list">
    {items.map((item) => (
      <div class="recipe-stats__item">
        <dt class="recipe-stats__label">{item.label}</dt>
        <dd class="recipe-stats__value">
          {item.datetime ? <time datetime={item.datetime}>{item.value}</time> : item.value}
        </dd>
      </div>
    ))}
  </dl>
</div>

<style>
@layer components {
  .recipe-stats {
    container-type: inline-size;

    .recipe-stats__list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin: 0;
      border-radius: var(--radius-lg);
      background: var(--surface);

      @media (min-width: 900px) {
        border-radius: 0;
        border-block: 1px solid var(--line);
        background: none;
      }
    }

    .recipe-stats__item {
      display: flex;
      flex-direction: column;
      gap: 0.375rem;
      padding: 0.875rem 1rem;

      @media (min-width: 900px) {
        padding: 1rem;

        &:nth-child(odd) {
          padding-inline-start: 0;
        }
      }

      &:nth-child(even) {
        border-inline-start: 1px solid var(--line);
      }

      &:nth-child(n + 3) {
        border-block-start: 1px solid var(--line);
      }
    }

    .recipe-stats__label {
      font-family: var(--font-mono);
      font-size: 0.6875rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--ink-3);
    }

    .recipe-stats__value {
      margin: 0;
      font-family: var(--font-serif);
      font-size: 1.375rem;
      line-height: 1.2;
      color: var(--ink);
    }

    @container (min-width: 32rem) {
      .recipe-stats__list {
        grid-template-columns: none;
        grid-auto-flow: column;
        grid-auto-columns: minmax(0, 1fr);
      }

      .recipe-stats__item {
        @media (min-width: 900px) {
          &:nth-child(odd) {
            padding-inline-start: 1rem;
          }

          &:first-child {
            padding-inline-start: 0;
          }
        }

        &:nth-child(n + 2) {
          border-inline-start: 1px solid var(--line);
        }

        &:nth-child(n + 3) {
          border-block-start: 0;
        }
      }
    }
  }

  .recipe-stats {
    @media print {
      .recipe-stats__list {
        border: 1px solid var(--line);
      }
    }
  }
}
</style>
