---
import TagCard from "@components/TagCard.astro";

interface Item {
  name: string;
  href: string;
  meta?: string;
  badge?: string;
}

interface Props {
  items: Item[];
  class?: string;
  [key: string]: unknown;
}

const { items, class: className, ...rest } = Astro.props;
---

<ul class:list={["tags", className]} {...rest}>
  {items.map((item) => (
    <li class:list={["tags__item", item.badge && "tags__item--highlight"]}>
      <TagCard {...item} />
    </li>
  ))}
</ul>

<style>
@layer components {
  .tags {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.625rem;

    @media (min-width: 600px) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }

    @media (min-width: 900px) {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  .tags__item--highlight {
    grid-column: span 2;

    @media (min-width: 600px) {
      grid-column: auto;
    }
  }
}
</style>
