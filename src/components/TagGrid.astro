---
import TagCard from "@components/TagCard.astro";

interface Item {
  name: string;
  meta?: string;
  imageSrc?: string;
  imageAlt?: string;
}

interface Props {
  items: Item[];
  class?: string;
  [key: string]: unknown;
}

const { items, class: className, ...rest } = Astro.props;
---

<ul class:list={["tags", className]} {...rest}>
  {items.map((item) => (
    <li>
      <TagCard {...item} />
    </li>
  ))}
</ul>

<style>
@layer components {
  .tags {
    display: flex;
    gap: 0.875rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding: 0.25rem var(--gutter) 0.5rem;
    margin-inline: calc(var(--gutter) * -1);
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none;
    }

    & > li {
      flex: 0 0 60%;
      max-width: 13.75rem;
      scroll-snap-align: start;
    }

    @media (min-width: 600px) {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
      overflow: visible;
      padding: 0;
      margin-inline: 0;

      & > li {
        flex: initial;
        max-width: none;
      }
    }

    @media (min-width: 900px) {
      grid-template-columns: repeat(5, 1fr);
    }
  }
}
</style>
