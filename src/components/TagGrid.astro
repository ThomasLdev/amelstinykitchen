---
import TagCard from "@components/TagCard.astro";
import type { Season } from "@lib/content/season";
import type { ImageMetadata } from "astro";

interface Item {
  name: string;
  href: string;
  meta?: string;
  badge?: string;
  image?: ImageMetadata;
  /** Season cards are all rendered; only the visitor's season stays visible. */
  season?: Season;
  hidden?: boolean;
}

interface Props {
  items: Item[];
  class?: string;
  [key: string]: unknown;
}

const { items, class: className, ...rest } = Astro.props;
---

<ul class:list={["tags", className]} {...rest}>
  {items.map((item) => (
    <li
      class:list={["tags__item", item.badge && "tags__item--highlight"]}
      data-season-card={item.season}
      hidden={item.hidden}
    >
      <TagCard
        name={item.name}
        href={item.href}
        meta={item.meta}
        badge={item.badge}
        image={item.image}
      />
    </li>
  ))}
</ul>

<script>
import "@scripts/season-cards";
</script>

<style>
@layer components {
  .tags {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.625rem;

    @media (min-width: 600px) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }

    @media (min-width: 900px) {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  .tags__item--highlight {
    grid-column: span 2;

    @media (min-width: 600px) {
      grid-column: auto;
    }
  }
}
</style>
