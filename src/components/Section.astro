---
interface Props {
  class?: string;
  [key: string]: unknown;
}

const { class: className, ...rest } = Astro.props;
---

<section class:list={["section", className]} {...rest}>
  <slot />
</section>

<style>
@layer components {
  .section {
    padding-block: var(--space-5);

    &:last-child {
      padding-block-end: 0;
    }
  }
}
</style>
