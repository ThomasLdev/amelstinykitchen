---
import { type CollectionEntry, getCollection, getEntries, getEntry } from "astro:content";
import { getAbsoluteLocaleUrl, getRelativeLocaleUrl } from "astro:i18n";
import Breadcrumb from "@components/Breadcrumb.astro";
import Button from "@components/Button.astro";
import ChefNote from "@components/ChefNote.astro";
import Container from "@components/Container.astro";
import Ingredients from "@components/Ingredients.astro";
import MediaCarousel from "@components/MediaCarousel.astro";
import Prose from "@components/Prose.astro";
import RecipeGrid from "@components/RecipeGrid.astro";
import RecipeHead from "@components/RecipeHead.astro";
import RecipeStats from "@components/RecipeStats.astro";
import RecipeStep from "@components/RecipeStep.astro";
import Section from "@components/Section.astro";
import SectionHead from "@components/SectionHead.astro";
import SectionTitle from "@components/SectionTitle.astro";
import SegmentedControl from "@components/SegmentedControl.astro";
import { type Locale, useTranslations } from "@i18n";
import BaseLayout from "@layouts/BaseLayout.astro";
import { assertTranslations, inLocale, translationsOf } from "@lib/content/i18n";
import {
  formatDuration,
  ingredientCount,
  isPublished,
  recipeSharedFields,
  recipeTransitionName,
  selectRelatedRecipes,
  totalTime,
} from "@lib/content/recipe";
import { ogImage } from "@lib/seo/images";
import { breadcrumbLd, recipeLd } from "@lib/seo/jsonld";
import { isoDuration } from "@lib/seo/recipe";
import { recipePath, resolveRecipe } from "@lib/seo/resolve";
import { siteConfig, socialProfiles } from "@site";

export async function getStaticPaths() {
  assertTranslations(await getCollection("recipes"), recipeSharedFields);
  const recipes = await getCollection("recipes", (entry) =>
    isPublished(entry, import.meta.env.PROD),
  );

  return recipes.map((recipe) => ({
    params: { lang: recipe.data.locale, slug: recipe.data.paths },
    props: {
      recipe,
      recipes: recipes.filter(inLocale(recipe.data.locale)),
      translations: translationsOf(recipe, recipes),
    },
  }));
}

interface Props {
  recipe: CollectionEntry<"recipes">;
  /** Every published recipe in the same locale, for the related recipes block. */
  recipes: CollectionEntry<"recipes">[];
  /** Published translations only: a missing one gets no hreflang nor language link. */
  translations: Partial<Record<Locale, CollectionEntry<"recipes">>>;
}

const { recipe, recipes, translations } = Astro.props;
const { locale } = recipe.data;
const t = useTranslations(locale);
const data = recipe.data;

const category = await getEntry(data.category);
const tags = await getEntries(data.tags);
const tagLabels = tags.map((tag) => tag.data[locale].title);
const kicker = [category?.data[locale].title, ...tagLabels].filter(Boolean).join(" · ");

const preparationTime = formatDuration(data.preparationTime, locale);
const cookingTime = formatDuration(data.cookingTime, locale);
const totalRecipeTime = formatDuration(totalTime(data.preparationTime, data.cookingTime), locale);
const ingredientsCount = ingredientCount(data.ingredientGroups);
const recipeAnchor = "recipe";

// Category pages do not exist yet: the category crumb stays plain text so
// crawlers never follow a link to a 404.
const breadcrumbItems: { label: string; href?: string }[] = [
  { label: t.recipe.breadcrumb.home, href: getRelativeLocaleUrl(locale, "") },
  { label: t.recipe.breadcrumb.recipes, href: getRelativeLocaleUrl(locale, "recipes") },
];
if (category) {
  breadcrumbItems.push({ label: category.data[locale].title });
}

const groups = data.ingredientGroups.map((group, groupIndex) => ({
  label: group.label || undefined,
  ingredients: group.ingredients.map((ingredient, index) => ({
    ...ingredient,
    id: `${data.translationKey}-${groupIndex}-${index}`,
  })),
}));

const steps = data.steps.map((step, index) => ({ ...step, index: index + 1 }));

// Below 720px a multi-image carousel shows 85% wide slides; the page gutter
// is 4vw on phones, hence 92vw for a full-bleed image.
const mobileSlide = (count: number) => (count > 1 ? "78vw" : "92vw");

const site = Astro.site ?? new URL(Astro.url.origin);
const resolved = await resolveRecipe(recipe, site);
const title = data.metaTitle ?? `${resolved.title} · ${siteConfig.name}`;
const hero = data.media[0];
const shareImage = hero && (await ogImage(hero.src, hero.alt, site));
const homeUrl = getAbsoluteLocaleUrl(locale, "");
const jsonLd = [
  recipeLd(resolved, { name: siteConfig.author.name, url: homeUrl, sameAs: socialProfiles() }),
  // Without the visible category crumb: a middle item needs a URL and category
  // pages do not exist yet.
  breadcrumbLd([
    { name: t.recipe.breadcrumb.home, url: homeUrl },
    { name: t.recipe.breadcrumb.recipes, url: getAbsoluteLocaleUrl(locale, "recipes") },
    { name: resolved.title, url: resolved.url },
  ]),
];
const alternates = Object.fromEntries(
  Object.entries(translations).map(([lang, entry]) => [lang, recipePath(entry)]),
);

const related = selectRelatedRecipes(recipe, recipes).map((entry) => ({
  href: getRelativeLocaleUrl(locale, recipePath(entry)),
  title: entry.data.title,
  meta: [
    formatDuration(totalTime(entry.data.preparationTime, entry.data.cookingTime), locale),
    t.recipe.difficulty[entry.data.difficulty],
  ]
    .filter(Boolean)
    .join(" · "),
  image: entry.data.media[0]?.src,
  transitionName: recipeTransitionName(entry),
}));
---

<BaseLayout
  title={title}
  description={resolved.description}
  locale={locale}
  alternates={alternates}
  image={shareImage}
  type="article"
  publishedTime={data.publishDate}
  modifiedTime={data.updatedDate}
  jsonLd={jsonLd}
  markdownUrl={resolved.markdownUrl}
>
  <Breadcrumb
    slot="breadcrumb"
    items={breadcrumbItems}
    current={data.title}
    label={t.a11y.breadcrumb}
  />

  <div
    data-recipe-portions
    data-recipe-portions-base={data.servings}
    data-recipe-portions-min="1"
    data-recipe-portions-max="24"
    data-locale={locale}
  >
    <Container>
      <RecipeHead
        locale={locale}
        title={data.title}
        tags={tagLabels}
        excerpt={data.excerpt}
        kicker={kicker}
        recipeAnchor={steps.length > 0 ? recipeAnchor : undefined}
      >
        <RecipeStats
          slot="stats"
          prepLabel={t.recipe.prep}
          cookLabel={t.recipe.cook}
          totalLabel={t.recipe.total}
          difficultyLabel={t.recipe.difficultyLabel}
          difficultyValue={t.recipe.difficulty[data.difficulty]}
          preparationTime={preparationTime}
          cookingTime={cookingTime}
          totalTime={totalRecipeTime}
          datetimes={{
            preparation: isoDuration(data.preparationTime),
            cooking: isoDuration(data.cookingTime),
            total: isoDuration(totalTime(data.preparationTime, data.cookingTime)),
          }}
        />

        <MediaCarousel
          slot="media"
          media={data.media}
          locale={locale}
          variant="hero"
          widths={[480, 720, 960, 1280]}
          sizes="(min-width: 1280px) 34rem, (min-width: 900px) 45vw, 92vw"
          eager
          transitionName={recipeTransitionName(recipe)}
        />
      </RecipeHead>
    </Container>

    {steps.length > 0 ? (
      <Container>
        <div class="recipe-body" id={recipeAnchor}>
          <SegmentedControl
            class="recipe-body__view"
            name="recipe-view"
            legend={t.recipe.view.legend}
            options={[
              { value: "ingredients", label: `${t.recipe.view.ingredients} · ${ingredientsCount}` },
              { value: "steps", label: `${t.recipe.view.steps} · ${steps.length}` },
            ]}
            data-recipe-view
          />

          <Ingredients
            class="recipe-body__ingredients"
            groups={groups}
            total={ingredientsCount}
            servings={data.servings}
            recipeId={data.translationKey}
            locale={locale}
          >
            <Button slot="footer" class="recipe-body__done" data-recipe-view-show="steps" hidden>
              {t.recipe.ingredients.done}
            </Button>
          </Ingredients>

          <section class="recipe-steps">
            <SectionTitle
              class="recipe-steps__title"
              title={t.recipe.steps.title}
              titleEm={t.recipe.steps.titleEm}
            />

            <ol class="recipe-steps__list">
              {steps.map((step) => (
                <RecipeStep {...step} locale={locale} />
              ))}
            </ol>

            {data.chefNote && (
              <ChefNote title={data.chefNote.title} body={data.chefNote.body} locale={locale} />
            )}
          </section>
        </div>
      </Container>
    ) : (
      data.sections.length > 0 && (
        <Container>
          <div class="recipe-sections">
            {data.sections.map((section) => (
              <section class="post-section">
                {section.title && <h2 class="post-section__title">{section.title}</h2>}
                <Prose html={section.content} />
                {section.media.length > 0 && (
                  <MediaCarousel
                    media={section.media}
                    locale={locale}
                    sizes={`(min-width: 900px) 42rem, (min-width: 720px) 92vw, ${mobileSlide(section.media.length)}`}
                  />
                )}
              </section>
            ))}
          </div>
        </Container>
      )
    )}

    {related.length > 0 && (
      <Section class="recipe-related">
        <Container>
          <SectionHead
            kicker={t.recipe.related.kicker}
            title={t.recipe.related.title}
            titleEm={t.recipe.related.titleEm}
          />
          <RecipeGrid items={related} />
        </Container>
      </Section>
    )}
  </div>

  <script>
  import "@scripts/recipe";
  </script>
</BaseLayout>

<style>
@layer components {
  .recipe-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block-start: var(--space-4);

    @media (min-width: 900px) {
      display: grid;
      grid-template-columns: 23.75rem minmax(0, 1fr);
      gap: var(--space-6);
      align-items: start;
      padding-block-start: var(--space-5);
      border-top: 1px solid var(--line);
    }
  }

  /* Mobile only: ingredients and steps become two panels switched by the
     segmented control. Desktop shows both side by side, so these rules are
     scoped below the layout breakpoint rather than undone above it. */
  @media screen and (width < 900px) {
    .recipe-body:has(.recipe-body__view input[value="steps"]:checked) .recipe-body__ingredients,
    .recipe-body:has(.recipe-body__view input[value="ingredients"]:checked) .recipe-steps {
      display: none;
    }
  }

  .recipe-body {
    @media print {
      .recipe-body__view,
      .recipe-body__done {
        display: none;
      }
    }

    @media (min-width: 900px) {
      .recipe-body__view,
      .recipe-body__done {
        display: none;
      }
    }
  }

  .recipe-steps {
    .recipe-steps__title {
      margin-block-start: 0.5rem;
      break-after: avoid;
    }
  }

  .recipe-related {
    @media print {
      display: none;
    }
  }

  .recipe-sections {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block-start: var(--space-4);

    .post-section {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .post-section__title {
      font-family: var(--font-serif);
      font-size: clamp(1.375rem, 4vw, 1.75rem);
      font-weight: 400;
      line-height: 1.15;
      color: var(--ink);
    }
  }
}
</style>
