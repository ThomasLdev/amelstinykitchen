---
import { type CollectionEntry, getCollection, getEntries, getEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Breadcrumb from "@components/Breadcrumb.astro";
import Button from "@components/Button.astro";
import ChefNote from "@components/ChefNote.astro";
import Container from "@components/Container.astro";
import Ingredients from "@components/Ingredients.astro";
import Kicker from "@components/Kicker.astro";
import MediaCarousel from "@components/MediaCarousel.astro";
import Prose from "@components/Prose.astro";
import RecipeHead from "@components/RecipeHead.astro";
import RecipeStats from "@components/RecipeStats.astro";
import RecipeStep from "@components/RecipeStep.astro";
import SegmentedControl from "@components/SegmentedControl.astro";
import { type Locale, languages, useTranslations } from "@i18n";
import BaseLayout from "@layouts/BaseLayout.astro";
import { translate } from "@lib/content/i18n";
import { formatDuration, ingredientCount, totalTime } from "@lib/content/recipe";

export async function getStaticPaths() {
  const recipes = await getCollection("recipes", ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  );
  const locales = Object.keys(languages) as Locale[];

  return recipes.flatMap((recipe) =>
    locales.map((locale) => ({
      params: { lang: locale, slug: recipe.data.paths[locale] },
      props: { recipe, locale },
    })),
  );
}

interface Props {
  recipe: CollectionEntry<"recipes">;
  locale: Locale;
}

const { recipe, locale } = Astro.props;
const t = useTranslations(locale);
const data = recipe.data;

const category = await getEntry(data.category);
const tags = await getEntries(data.tags);
const tagLabels = tags.map((tag) => translate(tag.data.title, locale));
const kicker = [category && translate(category.data.title, locale), ...tagLabels]
  .filter(Boolean)
  .join(" · ");

const preparationTime = formatDuration(data.preparationTime, locale);
const cookingTime = formatDuration(data.cookingTime, locale);
const totalRecipeTime = formatDuration(totalTime(data.preparationTime, data.cookingTime), locale);
const ingredientsCount = ingredientCount(data.ingredientGroups);
const recipeAnchor = "recipe";

const breadcrumbItems = [
  { label: t.recipe.breadcrumb.home, href: getRelativeLocaleUrl(locale, "") },
  { label: t.recipe.breadcrumb.recipes, href: getRelativeLocaleUrl(locale, "recipes") },
];
if (category) {
  breadcrumbItems.push({
    label: translate(category.data.title, locale),
    href: getRelativeLocaleUrl(locale, `recipes/${category.data.paths[locale]}`),
  });
}

const groups = data.ingredientGroups.map((group, groupIndex) => ({
  label: translate(group.label, locale) || undefined,
  ingredients: group.ingredients.map((ingredient, index) => ({
    id: `${recipe.id}-${groupIndex}-${index}`,
    name: translate(ingredient.name, locale),
    quantity: ingredient.quantity,
    unit: translate(ingredient.unit, locale),
    display: ingredient.display ? translate(ingredient.display, locale) : undefined,
  })),
}));

const steps = data.steps.map((step, index) => ({
  index: index + 1,
  title: translate(step.title, locale),
  content: translate(step.content, locale),
  tip: step.tip ? { type: step.tip.type, text: translate(step.tip.text, locale) } : undefined,
  media: step.media.map((item) => ({
    src: item.src,
    alt: translate(item.alt, locale),
  })),
}));

const recipeMedia = data.media.map((item) => ({
  src: item.src,
  alt: translate(item.alt, locale),
}));

// Below 720px a multi-image carousel shows 85% wide slides; the page gutter
// is 4vw on phones, hence 92vw for a full-bleed image.
const mobileSlide = (count: number) => (count > 1 ? "78vw" : "92vw");

const chefNote = data.chefNote
  ? {
      title: translate(data.chefNote.title, locale),
      body: translate(data.chefNote.body, locale),
    }
  : undefined;
---

<BaseLayout
  title={translate(data.metaTitle ?? data.title, locale)}
  description={translate(data.metaDescription ?? data.excerpt, locale)}
  locale={locale}
>
  <div
    data-recipe-portions
    data-recipe-portions-base={data.servings}
    data-recipe-portions-min="1"
    data-recipe-portions-max="24"
    data-locale={locale}
  >
    <Container>
      <RecipeHead
        locale={locale}
        title={translate(data.title, locale)}
        tags={tagLabels}
        excerpt={translate(data.excerpt, locale)}
        kicker={kicker}
        recipeAnchor={steps.length > 0 ? recipeAnchor : undefined}
      >
        <Breadcrumb
          slot="breadcrumb"
          items={breadcrumbItems}
          current={translate(data.title, locale)}
          label={t.a11y.breadcrumb}
        />

        <RecipeStats
          slot="stats"
          prepLabel={t.recipe.prep}
          cookLabel={t.recipe.cook}
          totalLabel={t.recipe.total}
          difficultyLabel={t.recipe.difficultyLabel}
          difficultyValue={t.recipe.difficulty[data.difficulty]}
          preparationTime={preparationTime}
          cookingTime={cookingTime}
          totalTime={totalRecipeTime}
        />

        <MediaCarousel
          slot="media"
          media={recipeMedia}
          locale={locale}
          variant="hero"
          widths={[480, 720, 960, 1280]}
          sizes="(min-width: 1280px) 34rem, (min-width: 900px) 45vw, 92vw"
          eager
        />
      </RecipeHead>
    </Container>

    {steps.length > 0 ? (
      <Container>
        <div class="recipe-body" id={recipeAnchor}>
          <SegmentedControl
            class="recipe-body__view"
            name="recipe-view"
            legend={t.recipe.view.legend}
            options={[
              { value: "ingredients", label: `${t.recipe.view.ingredients} · ${ingredientsCount}` },
              { value: "steps", label: `${t.recipe.view.steps} · ${steps.length}` },
            ]}
            data-recipe-view
          />

          <Ingredients
            class="recipe-body__ingredients"
            groups={groups}
            total={ingredientsCount}
            servings={data.servings}
            recipeId={recipe.id}
            locale={locale}
          >
            <Button slot="footer" class="recipe-body__done" data-recipe-view-show="steps" hidden>
              {t.recipe.ingredients.done}
            </Button>
          </Ingredients>

          <section class="recipe-steps">
            <h2 class="recipe-steps__title">
              {t.recipe.steps.title} <em>{t.recipe.steps.titleEm}</em>
            </h2>

            {steps.map((step) => (
              <RecipeStep {...step} locale={locale} />
            ))}

            {chefNote && <ChefNote title={chefNote.title} body={chefNote.body} locale={locale} />}
          </section>
        </div>
      </Container>
    ) : (
      data.sections.length > 0 && (
        <Container>
          <div class="recipe-sections">
            {data.sections.map((section) => (
              <section class="post-section">
                {translate(section.title, locale) && (
                  <h2 class="post-section__title">{translate(section.title, locale)}</h2>
                )}
                <Prose html={translate(section.content, locale)} />
                {section.media.length > 0 && (
                  <MediaCarousel
                    media={section.media.map((item) => ({
                      src: item.src,
                      alt: translate(item.alt, locale),
                    }))}
                    locale={locale}
                    sizes={`(min-width: 900px) 42rem, (min-width: 720px) 92vw, ${mobileSlide(section.media.length)}`}
                  />
                )}
              </section>
            ))}
          </div>
        </Container>
      )
    )}

    <script>
    import "@scripts/recipe";
    </script>
  </div>
</BaseLayout>

<style>
@layer components {
  .recipe-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block: var(--space-4);

    @media (min-width: 900px) {
      display: grid;
      grid-template-columns: 23.75rem minmax(0, 1fr);
      gap: var(--space-6);
      align-items: start;
      padding-block: var(--space-5) var(--space-6);
      border-top: 1px solid var(--line);
    }
  }

  /* Mobile only: ingredients and steps become two panels switched by the
     segmented control. Desktop shows both side by side, so these rules are
     scoped below the layout breakpoint rather than undone above it. */
  @media (width < 900px) {
    .recipe-body:has(.recipe-body__view input[value="steps"]:checked) .recipe-body__ingredients,
    .recipe-body:has(.recipe-body__view input[value="ingredients"]:checked) .recipe-steps {
      display: none;
    }
  }

  .recipe-body {
    @media (min-width: 900px) {
      .recipe-body__view,
      .recipe-body__done {
        display: none;
      }
    }
  }

  .recipe-steps {
    .recipe-steps__title {
      margin-block-start: 0.5rem;
      margin-block-end: 0;
      font-family: var(--font-serif);
      font-size: clamp(1.625rem, 5.5vw, 3.25rem);
      font-weight: 400;
      line-height: 1.05;
      color: var(--ink);
    }

    .recipe-steps__title em {
      font-style: italic;
      font-weight: 300;
      color: var(--accent-ink);
    }
  }

  .recipe-sections {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block: var(--space-4);

    .post-section {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .post-section__title {
      font-family: var(--font-serif);
      font-size: clamp(1.375rem, 4vw, 1.75rem);
      font-weight: 400;
      line-height: 1.15;
      color: var(--ink);
    }
  }
}
</style>
