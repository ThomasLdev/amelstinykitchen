---
import { getCollection, getEntries } from "astro:content";
import { getAbsoluteLocaleUrl, getRelativeLocaleUrl } from "astro:i18n";
import Container from "@components/Container.astro";
import Cravings from "@components/Cravings.astro";
import FeaturedRecipe from "@components/FeaturedRecipe.astro";
import HomeHero from "@components/HomeHero.astro";
import RecipeGrid from "@components/RecipeGrid.astro";
import SearchForm from "@components/SearchForm.astro";
import Section from "@components/Section.astro";
import SectionHead from "@components/SectionHead.astro";
import ViewAllLink from "@components/ViewAllLink.astro";
import { localeParams, toLocale, useTranslations } from "@i18n";
import BaseLayout from "@layouts/BaseLayout.astro";
import {
  selectFeaturedTags,
  selectHeroRecipe,
  selectPopularRecipes,
  selectSeasonRecipes,
} from "@lib/content/home";
import { localize } from "@lib/content/i18n";
import { formatDuration, totalTime } from "@lib/content/recipe";
import { factsLine, recipeCard, recipeFacts, recipeHref } from "@lib/content/recipe-card";
import { getPublishedRecipes } from "@lib/content/recipe-catalog";
import { currentSeason, SEASONS } from "@lib/content/season";
import { seasonImages } from "@lib/content/season-images";
import { ogImage } from "@lib/seo/images";
import { websiteLd } from "@lib/seo/jsonld";
import { siteConfig, socialProfiles } from "@site";

export const getStaticPaths = localeParams;

const locale = toLocale(Astro.params.lang);
const t = useTranslations(locale);

const recipes = await getPublishedRecipes(locale);
const tags = (await getCollection("tags")).map((tag) => localize(tag, locale));

const recipesUrl = getRelativeLocaleUrl(locale, "recipes");

const heroRecipe = selectHeroRecipe(recipes);
const hero = heroRecipe && {
  ...recipeCard(heroRecipe, locale),
  meta: factsLine([
    ...recipeFacts(heroRecipe, locale),
    ...(await getEntries(heroRecipe.data.tags)).map((tag) => tag.data[locale].title),
  ]),
  imageAlt: heroRecipe.data.media[0]?.alt ?? "",
};

const popular = selectPopularRecipes(recipes).map((recipe) => {
  const card = recipeCard(recipe, locale);
  return {
    ...card,
    excerpt: recipe.data.excerpt || undefined,
    // Names must be unique per page and the hero may also be popular.
    transitionName: recipe === heroRecipe ? undefined : card.transitionName,
  };
});

const cravingTags = selectFeaturedTags(tags, recipes, 7).map(({ tag }) => ({
  name: tag.data.title,
  href: `${recipesUrl}?tag=${tag.id}`,
  image: tag.data.image,
}));

// Every season with recipes is rendered: the script shows the visitor's, the build's without JS.
const buildSeason = currentSeason(new Date());
const seasons = SEASONS.map((season) => ({ season, list: selectSeasonRecipes(recipes, season) }))
  .filter(({ list }) => list.length > 0)
  .map(({ season, list }) => ({
    season,
    hidden: season !== buildSeason,
    title: t.home.tags.seasonTitle[season],
    badge: t.home.tags.inSeason,
    image: seasonImages[season],
    recipes: list.slice(0, 3).map((recipe) => ({
      href: recipeHref(recipe, locale),
      title: recipe.data.title,
      meta:
        formatDuration(totalTime(recipe.data.preparationTime, recipe.data.cookingTime), locale) ??
        undefined,
      image: recipe.data.media[0]?.src,
    })),
    cta: {
      href: `${recipesUrl}?season=${season}`,
      label: t.home.tags.seasonRecipes[season](list.length),
    },
  }));

const site = Astro.site ?? new URL(Astro.url.origin);
const homeUrl = getAbsoluteLocaleUrl(locale, "");
const heroMedia = heroRecipe?.data.media[0];
const shareImage = heroMedia && (await ogImage(heroMedia.src, heroMedia.alt, site));
const jsonLd = [
  websiteLd({
    url: homeUrl,
    name: siteConfig.name,
    description: t.meta.description,
    locale,
    publisher: { name: siteConfig.author.name, url: homeUrl, sameAs: socialProfiles() },
  }),
];
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  locale={locale}
  alternates={{ fr: "", en: "" }}
  image={shareImage}
  jsonLd={jsonLd}
>
  <Container>
    <HomeHero
      kicker={t.home.intro.kicker}
      title={t.home.intro.title}
      titleEm={t.home.intro.titleEm}
    >
      <SearchForm
        action={recipesUrl}
        label={t.home.search.label}
        placeholder={t.home.search.placeholder}
        submitLabel={t.home.search.submit}
      />
      {hero && <FeaturedRecipe slot="aside" {...hero} badge={t.home.featured.badge} />}
    </HomeHero>
  </Container>

  {(cravingTags.length > 0 || seasons.length > 0) && (
    <Section>
      <Container>
        <SectionHead
          kicker={t.home.tags.kicker}
          title={t.home.tags.title}
          titleEm={t.home.tags.titleEm}
          sub={t.home.tags.sub}
        />
        <Cravings
          seasons={seasons}
          nav={{
            label: t.home.tags.nav,
            items: cravingTags,
            all: { href: recipesUrl, label: t.home.tags.all },
          }}
        />
      </Container>
    </Section>
  )}

  {popular.length > 0 && (
    <Section>
      <Container>
        <SectionHead
          kicker={t.home.popular.kicker}
          title={t.home.popular.title}
          titleEm={t.home.popular.titleEm}
        >
          <ViewAllLink slot="action" href={recipesUrl} label={t.home.popular.viewAll} />
        </SectionHead>
        <RecipeGrid items={popular} />
        <ViewAllLink placement="foot" href={recipesUrl} label={t.home.popular.viewAll} />
      </Container>
    </Section>
  )}
</BaseLayout>
