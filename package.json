{
  "name": "amelstinykitchen",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "sync": "astro sync",
    "check": "astro check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "knip": "knip",
    "spell": "cspell --no-progress --no-summary .",
    "deploy": "astro build && wrangler deploy",
    "preview:cf": "astro build && wrangler dev"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.8",
    "minisearch": "^7.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.15",
    "@cspell/dict-fr-fr": "^2.3.2",
    "@playwright/test": "^1.64.0",
    "@sveltia/cms": "0.227.3",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "cspell": "^10.3.6",
    "knip": "^6.41.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
